/* icon 占位容器 */
.icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: -6rpx;
  overflow: visible;
}

/* 旅拍相册和我的图标向上调整 */
.icon-adjust-up {
  margin-top: -18rpx;
}

/* 视觉中心对齐调整 */
.icon-align-template {
  transform: translateY(2rpx);
  position: relative;
}

.icon-align-experience {
  transform: translateY(5rpx);
}

.icon-align-purchase {
  transform: translateY(2.5rpx);
}

.icon-align-album {
  transform: translateY(-10rpx) scale(1.2);
}

.icon-align-my {
  transform: translateY(-9rpx) scale(1.3);
}

/* icon 尺寸 */
.tab-icon {
  width: 70rpx;
  height: 70rpx;
  display: block;
}

/* 文本基础样式（未选中默认） */
.tab-text {
  font-size: 20rpx;
  line-height: 1.2;
  color: #666;
  transition: opacity 0.1s ease, font-size 0.1s ease, color 0.1s ease;
  margin-top: 18rpx;
  text-align: center;
  white-space: nowrap;
  position: relative;
}

/* 选中态（icon + text 共用） */
.is-active {
  opacity: 1;
}

/* 未选中态 */
.is-inactive {
  opacity: 0.55;
}

/* ✅ 只作用在「文字 + 选中态」 */
.tab-text.is-active {
  font-size: 24rpx;
  color: #82F45F;
  font-weight: 500;
}
