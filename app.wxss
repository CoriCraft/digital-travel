/**app.wxss**/

/* Disable TDesign external font loading to prevent CDN errors */
@font-face {
  font-family: 't-icon';
  src: local('Arial');
  unicode-range: U+0000-FFFF;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
} 
