/* pages/photoset-detail/photoset-detail.wxss */

/* 页面容器 */
.page {
  min-height: 100vh;
  background: transparent;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  padding: 0;
}

.share-btn::after {
  border: none;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* 主内容区域 */
.content {
  height: 100vh;
  background: transparent;
}

/* 照片区域 */
.photo-section {
  position: relative;
  width: 100%;
  height: 750rpx;
  background: #f5f5f5;
  border-radius: 0 0 32rpx 32rpx;
  overflow: hidden;
}

.photo-swiper {
  width: 100%;
  height: 100%;
}

.photo-image {
  width: 100%;
  height: 100%;
}

/* 照片指示器 */
.photo-indicator {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  padding: 12rpx 24rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 40rpx;
  backdrop-filter: blur(10px);
}

.indicator-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
}

/* 信息区域 */
.info-section {
  padding: 32rpx 24rpx;
}

/* 标题区域 */
.title-area {
  margin-bottom: 32rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1a1a1a;
  line-height: 1.3;
  flex: 1;
}

.badge {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #82F45F 0%, #6FD84A 100%);
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(130, 244, 95, 0.25);
}

.description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  display: block;
}

/* 作者卡片 */
.author-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, rgba(130, 244, 95, 0.08) 0%, rgba(143, 241, 236, 0.08) 100%);
  border-radius: 24rpx;
  border: 2rpx solid rgba(130, 244, 95, 0.15);
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 3rpx solid rgba(130, 244, 95, 0.3);
}

.author-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.author-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.publish-time {
  font-size: 24rpx;
  color: #999;
}

/* 统计行 */
.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #1a1a1a;
  margin-top: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #eee;
}

/* 模板卡片 */
.template-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, rgba(130, 244, 95, 0.1) 0%, rgba(143, 241, 236, 0.1) 100%);
  border-radius: 24rpx;
  border: 2rpx solid rgba(130, 244, 95, 0.2);
}

.template-icon {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(130, 244, 95, 0.15);
  border-radius: 20rpx;
  margin-right: 24rpx;
}

.template-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.template-label {
  font-size: 24rpx;
  color: #999;
}

.template-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #82F45F;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-evenly;
  padding: 16rpx 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 99;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: transparent;
  border: none;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  transition: all 0.3s ease;
  flex: 1;
  max-width: 200rpx;
}

.share-action::after {
  border: none;
}

.action-item:active {
  background: rgba(130, 244, 95, 0.1);
  transform: scale(0.95);
}

.action-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.action-icon.active {
  background: rgba(130, 244, 95, 0.15);
}

.action-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #666;
  transition: color 0.3s ease;
}

.action-label.active {
  color: #82F45F;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 安全区域 */
.safe-area {
  width: 100%;
}
