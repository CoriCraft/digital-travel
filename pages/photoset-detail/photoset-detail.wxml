<!-- pages/photoset-detail/photoset-detail.wxml -->
<view class="page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar" style="height: {{navBarHeight}}px;">
      <view class="nav-btn" bindtap="onBack">
        <t-icon name="chevron-left" size="48rpx" color="#1a1a1a" />
      </view>
      <view class="nav-title">照片详情</view>
      <button class="nav-btn share-btn" open-type="share">
        <t-icon name="share" size="44rpx" color="#1a1a1a" />
      </button>
    </view>
  </view>

  <!-- 主内容区域 -->
  <scroll-view class="content" scroll-y style="padding-top: calc({{statusBarHeight}}px + {{navBarHeight}}px);">
    <!-- 照片轮播区域 -->
    <view class="photo-section" wx:if="{{photoSet}}">
      <swiper
        class="photo-swiper"
        indicator-dots="{{false}}"
        autoplay="{{false}}"
        current="{{currentIndex}}"
        bindchange="onSwiperChange"
      >
        <swiper-item wx:for="{{photoSet.photos}}" wx:key="index">
          <image class="photo-image" src="{{item}}" mode="aspectFill" />
        </swiper-item>
      </swiper>

      <!-- 照片计数器 -->
      <view class="photo-indicator">
        <text class="indicator-text">{{currentIndex + 1}}/{{photoSet.photos.length}}</text>
      </view>
    </view>

    <!-- 信息区域 -->
    <view class="info-section" wx:if="{{photoSet}}">
      <!-- 标题区域 -->
      <view class="title-area">
        <view class="title-row">
          <text class="title">{{photoSet.title}}</text>
          <view class="badge" wx:if="{{photoSet.isOfficial}}">官方</view>
        </view>
        <text class="description" wx:if="{{photoSet.description}}">{{photoSet.description}}</text>
      </view>

      <!-- 作者信息 -->
      <view class="author-card">
        <image class="avatar" src="{{photoSet.userAvatar || defaultAvatar}}" mode="aspectFill" />
        <view class="author-info">
          <text class="author-name">{{photoSet.userName || '匿名用户'}}</text>
          <text class="publish-time">{{formattedTime}}</text>
        </view>
      </view>

      <!-- 数据统计 -->
      <view class="stats-row">
        <view class="stat-item">
          <t-icon name="browse" size="36rpx" color="#82F45F" />
          <text class="stat-value">{{photoSet.viewCount || 0}}</text>
          <text class="stat-label">浏览</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <t-icon name="heart-filled" size="36rpx" color="#82F45F" />
          <text class="stat-value">{{photoSet.likeCount || 0}}</text>
          <text class="stat-label">点赞</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <t-icon name="image" size="36rpx" color="#82F45F" />
          <text class="stat-value">{{photoSet.photos.length}}</text>
          <text class="stat-label">照片</text>
        </view>
      </view>

      <!-- 所属模板 -->
      <view class="template-card" bindtap="onViewTemplate" wx:if="{{photoSet.templateId}}">
        <view class="template-icon">
          <t-icon name="layers" size="40rpx" color="#82F45F" />
        </view>
        <view class="template-info">
          <text class="template-label">所属模板</text>
          <text class="template-name">{{photoSet.templateName || '查看详情'}}</text>
        </view>
        <t-icon name="chevron-right" size="40rpx" color="#ccc" />
      </view>

      <!-- 底部安全区域 -->
      <view class="safe-area" style="height: 120rpx;"></view>
    </view>

    <!-- 加载状态 -->
    <view class="loading-state" wx:if="{{!photoSet}}">
      <t-loading theme="circular" size="80rpx" />
      <text class="loading-text">加载中...</text>
    </view>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="action-bar" wx:if="{{photoSet}}">
    <view class="action-item" bindtap="onToggleLike">
      <view class="action-icon {{isLiked ? 'active' : ''}}">
        <t-icon name="heart{{isLiked ? '-filled' : ''}}" size="52rpx" color="{{isLiked ? '#82F45F' : '#666'}}" />
      </view>
      <text class="action-label {{isLiked ? 'active' : ''}}">{{isLiked ? '已赞' : '点赞'}}</text>
    </view>

    <view class="action-item" bindtap="onSavePhoto">
      <view class="action-icon">
        <t-icon name="download" size="52rpx" color="#666" />
      </view>
      <text class="action-label">保存</text>
    </view>

    <button class="action-item share-action" open-type="share">
      <view class="action-icon">
        <t-icon name="share" size="52rpx" color="#666" />
      </view>
      <text class="action-label">分享</text>
    </button>
  </view>
</view>
