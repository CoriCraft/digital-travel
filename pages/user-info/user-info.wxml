<view class="container">
  <view class="main-content" style="padding-top: {{statusBarHeight + navBarHeight + 40}}px;">
    <view class="welcome-section">
      <text class="welcome-title">欢迎来到「智见方境」</text>
      <text class="welcome-desc">请设置你的头像和昵称</text>
    </view>

    <view class="form-section">
      <!-- 头像昵称填写组件 -->
      <view class="profile-form">
        <!-- 头像选择 -->
        <view class="avatar-wrapper">
          <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image class="avatar" src="{{userAvatar}}" mode="aspectFill"></image>
          </button>
          <view class="avatar-tip">点击设置头像</view>
        </view>

        <!-- 昵称输入 -->
        <view class="form-item nickname-item">
          <input
            class="nickname-input"
            type="nickname"
            placeholder="请输入昵称"
            value="{{userName}}"
            bindinput="onNicknameInput"
            bindblur="onNicknameBlur"
            maxlength="20"
          />
        </view>
      </view>

      <!-- 提示文本 -->
      <view class="guide-tip">*点击头像选择照片，输入昵称后即可完成设置</view>
    </view>

    <view class="button-section">
      <button
        class="submit-btn {{canSubmit ? 'active' : ''}}"
        bindtap="onSubmit"
        disabled="{{!canSubmit}}"
      >
        完成设置
      </button>
    </view>
  </view>
</view>
