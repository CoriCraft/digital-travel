/* pages/user-info/user-info.wxss */

page {
  height: 100vh;
  width: 100%;
  background: linear-gradient(180deg, #E8F5E9 0%, #FFFFFF 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
}

.container {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: transparent;
}

.nav-content {
  width: 100%;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

/* 主内容 */
.main-content {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
  box-sizing: border-box;
}

/* 欢迎区域 */
.welcome-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.welcome-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.welcome-desc {
  font-size: 28rpx;
  color: #666;
}

/* 表单区域 */
.form-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 60rpx;
  margin-bottom: 80rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}

/* 头像选择 */
.avatar-btn {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f0f0f0;
  border: 4rpx solid #3ECE79;
  box-shadow: 0 8rpx 24rpx rgba(62, 206, 121, 0.2);
}

.avatar-tip {
  font-size: 24rpx;
  color: #999;
}

/* 昵称输入 */
.nickname-input {
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.nickname-input::placeholder {
  color: #CCCCCC;
}

/* 按钮区域 */
.button-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: #CCCCCC;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: all 0.3s;
}

.submit-btn::after {
  border: none;
}

.submit-btn.active {
  background: linear-gradient(135deg, #3ECE79 0%, #2AB566 100%);
  box-shadow: 0 8rpx 24rpx rgba(62, 206, 121, 0.3);
}

.submit-btn.active:active {
  transform: scale(0.98);
}

.skip-btn {
  width: 100%;
  height: 88rpx;
  background: transparent;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.skip-btn::after {
  border: none;
}
