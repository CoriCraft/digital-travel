/* pages/user-info/user-info.wxss */

page {
  height: 100vh;
  width: 100%;
  background: linear-gradient(180deg, #E8F5E9 0%, #FFFFFF 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
}

.container {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: transparent;
}

.nav-content {
  width: 100%;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

/* 主内容 */
.main-content {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
  box-sizing: border-box;
}

/* 欢迎区域 */
.welcome-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.welcome-title {
  font-weight: 700;
  font-size: 40rpx;
  line-height: 40rpx;
  text-align: center;
  letter-spacing: 2rpx;
  color: #282828;
  margin-bottom: 20rpx;
}

.welcome-desc {
  font-weight: 500;
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: center;
  color: #757575;
}

/* 表单区域 */
.form-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.profile-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 50rpx;
  margin-bottom: 40rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.avatar-item {
  margin-bottom: 20rpx;
}

.nickname-item {
  width: 100%;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
  font-weight: 500;
}

/* 头像选择 */
.avatar-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: #E5E5E5;
}

.avatar-tip {
  font-weight: 500;
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: center;
  color: #BBBBBB;
  margin-top: 20rpx;
}

/* 昵称输入 */
.nickname-input {
  width: 100%;
  height: 100rpx;
  background: #FFFFFF;
  border-radius: 50rpx;
  text-align: center;
  font-weight: 500;
  font-size: 24rpx;
  line-height: 40rpx;
  color: #333;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.nickname-input::placeholder {
  color: #BBBBBB;
}

/* 提示文本 */
.guide-tip {
  font-weight: 400;
  font-size: 20rpx;
  line-height: 40rpx;
  text-align: center;
  color: #75BE31;
  margin-top: 20rpx;
}

/* 按钮区域 */
.button-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.submit-btn {
  width: 100% !important;
  height: 98rpx;
  background: #DDDDDD;
  box-shadow: 2rpx 4rpx 10rpx rgba(0, 0, 0, 0.08);
  border-radius: 60rpx;
  font-weight: 500;
  font-size: 34rpx;
  line-height: 40rpx;
  text-align: center;
  letter-spacing: 2rpx;
  color: #939393;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: all 0.3s;
}

.submit-btn::after {
  border: none;
}

.submit-btn.active {
  background: linear-gradient(90deg, #86D93E 0%, #C0EC44 100%);
  box-shadow: 2rpx 4rpx 10rpx rgba(0, 0, 0, 0.08);
  color: #FFFFFF;
}

.submit-btn.active:active {
  transform: scale(0.98);
}
