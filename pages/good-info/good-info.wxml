<!--pages/good-info/good-info.wxml-->
<view class="page-container">
  <!-- 背景 -->
  <view class="top-bg-layer"></view>

  <!-- 顶部导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="onBack">
        <t-icon name="arrow-left" size="48rpx" color="#333" />
      </view>
      <view class="nav-title">商品详情</view>
      <view class="nav-right-placeholder"></view>
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-container" style="padding-top: {{statusBarHeight + navBarHeight + 200}}px;">
    <t-loading theme="circular" size="60rpx" text="加载中..." />
  </view>

  <!-- 页面主体 -->
  <scroll-view wx:else class="page-scroll" scroll-y enable-flex style="padding-top: {{statusBarHeight + navBarHeight + 24}}px;">

    <!-- 商品主图 -->
    <view class="product-hero">
      <image class="hero-img" src="{{goods.img}}" mode="aspectFill" />
    </view>

    <!-- 商品信息 -->
    <view class="product-info">
      <view class="product-title-row">
        <text class="product-title">{{goods.name}}</text>
        <view class="fav-icon" bindtap="toggleFavorite">
          <t-icon name="{{isFavorite ? 'star-filled' : 'star'}}" size="48rpx" color="{{isFavorite ? '#FFD700' : '#999'}}" />
        </view>
      </view>

      <!-- 评分显示 -->
      <view class="product-rating" wx:if="{{goods.rating > 0}}">
        <text class="rating-star">⭐</text>
        <text class="rating-num">{{goods.rating}}</text>
        <text class="rating-count">({{goods.reviewCount}}条评价)</text>
      </view>

      <view class="product-tags" wx:if="{{goods.tags.length > 0}}">
        <block wx:for="{{goods.tags}}" wx:key="*this">
          <text wx:if="{{goods.tagType === 'hot'}}" class="tag tag-hot">{{item}}</text>
          <text wx:elif="{{goods.tagType === 'discount-text'}}" class="tag tag-discount">{{item}}</text>
          <text wx:elif="{{goods.tagType === 'green'}}" class="tag tag-green">{{item}}</text>
          <text wx:else class="tag tag-plain">{{item}}</text>
        </block>
      </view>
    </view>

    <!-- 商品描述 -->
    <view class="product-desc">
      <view class="desc-header">
        <view class="desc-bar"></view>
        <text class="desc-text">商品描述</text>
      </view>
      <view class="desc-content">{{goods.description}}</view>
    </view>

    <!-- 商品详情 -->
    <view class="product-detail">
      <view class="detail-header">
        <view class="detail-bar"></view>
        <text class="detail-text">商品详情</text>
      </view>

      <!-- 如果有详情图片则显示 -->
      <block wx:if="{{goods.detailImages && goods.detailImages.length > 0}}">
        <image wx:for="{{goods.detailImages}}" wx:key="*this" class="detail-img" src="{{item}}" mode="widthFix" />
      </block>

      <!-- 否则显示商品主图 -->
      <block wx:else>
        <image class="detail-img" src="{{goods.img}}" mode="widthFix" />
      </block>
    </view>

    <!-- 用户评价 -->
    <view class="reviews-section">
      <view class="reviews-header">
        <view class="reviews-bar"></view>
        <text class="reviews-text">用户评价</text>
        <text class="reviews-count">({{reviewCount}})</text>
      </view>

      <!-- 写评价按钮 -->
      <view class="write-review-btn" bindtap="onWriteReview">
        <t-icon name="edit" size="32rpx" color="#ff6b35" />
        <text>写评价</text>
      </view>

      <!-- 评价列表 -->
      <view wx:if="{{reviews.length > 0}}" class="reviews-list">
        <view class="review-item" wx:for="{{reviews}}" wx:key="_id" bindlongpress="onReviewReport" data-id="{{item._id}}" data-type="goods" data-content="{{item.content}}" data-userid="{{item.userId}}">
          <view class="review-user">
            <image class="user-avatar" src="{{item.userAvatar || '/static/icons/default-avatar.png'}}" />
            <view class="user-info">
              <text class="user-name">{{item.userName}}</text>
              <view class="review-rating">
                <text class="star {{starIndex + 1 <= item.rating ? 'active' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:key="starIndex" wx:for-item="starItem" wx:for-index="starIndex">★</text>
              </view>
            </view>
            <text class="review-time">{{item.createTime}}</text>
          </view>
          <view class="review-content">{{item.content}}</view>
        </view>
      </view>

      <!-- 暂无评价 -->
      <view wx:else class="no-reviews">
        <t-icon name="chat" size="80rpx" color="#ccc" />
        <text class="no-reviews-text">暂无评价，快来抢沙发吧~</text>
      </view>
    </view>

    <view style="height: 40rpx;"></view>
  </scroll-view>

</view>