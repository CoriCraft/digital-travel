/* pages/good-info/good-info.wxss */
.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
  position: relative;
}

.top-bg-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 500rpx;
  background: linear-gradient(180deg, #DFF7E2 0%, #F0F9F4 60%, #F7F8FA 100%);
  z-index: 0;
}

/* --- 导航栏 --- */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background: transparent;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-left {
  width: 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 30px;
  height: 35px;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.nav-right-placeholder {
  width: 60rpx;
  height: 100%;
}

/* 加载中 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 页面滚动区 */
.page-scroll {
  padding-bottom: 40rpx;
}

/* 商品主图 */
.product-hero {
  margin: 0 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fff;
}

.hero-img {
  width: 100%;
  height: 480rpx;
  background-color: #eee;
}

/* 微信小店商品卡片 */
.store-product-section {
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
}

.store-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx;
  background: linear-gradient(135deg, #fff5f0, #ffe8dc);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.tip-icon {
  font-size: 32rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #ff6b35;
  font-weight: 500;
}

/* 商品信息 */
.product-info {
  margin: 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 20rpx;
}

.product-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.product-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.5;
  margin-right: 16rpx;
}

.fav-icon {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
}

/* 商品评分 */
.product-rating {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.rating-star {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.rating-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff6b35;
  margin-right: 8rpx;
}

.rating-count {
  font-size: 24rpx;
  color: #999;
}

.product-tags {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.tag-hot {
  background: #ffecec;
  color: #ff4d4f;
}

.tag-discount {
  background: #fff7e6;
  color: #fa8c16;
}

.tag-green {
  background: #e8f7ec;
  color: #2bae66;
}

.tag-plain {
  background: #f5f5f5;
  color: #666;
}

/* 商品描述 */
.product-desc {
  margin: 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 20rpx;
}

.desc-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.desc-bar {
  width: 6rpx;
  height: 28rpx;
  background-color: #7bc96f;
  border-radius: 3rpx;
  margin-right: 12rpx;
}

.desc-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.desc-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 详情标题 */
.detail-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.detail-bar {
  width: 6rpx;
  height: 28rpx;
  background-color: #7bc96f;
  border-radius: 3rpx;
  margin-right: 12rpx;
}

.detail-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

/* 详情图片区 */
.product-detail {
  margin: 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 20rpx;
}

.detail-img {
  width: 100%;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
}

/* 用户评价 */
.reviews-section {
  margin: 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 20rpx;
}

.reviews-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.reviews-bar {
  width: 6rpx;
  height: 28rpx;
  background-color: #7bc96f;
  border-radius: 3rpx;
  margin-right: 12rpx;
}

.reviews-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.reviews-count {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.write-review-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #fff5f0, #ffe8dc);
  border: 2rpx solid #ff6b35;
  border-radius: 36rpx;
  color: #ff6b35;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.review-item {
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.review-user {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.review-rating {
  display: flex;
  gap: 4rpx;
}

.review-rating .star {
  font-size: 24rpx;
  color: #ddd;
}

.review-rating .star.active {
  color: #ffa940;
}

.review-time {
  font-size: 22rpx;
  color: #999;
}

.review-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.no-reviews {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.no-reviews-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 24rpx;
}
