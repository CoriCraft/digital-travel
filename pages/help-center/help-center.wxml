<view class="container">
  <!-- 导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="onBack">
        <view class="back-icon"></view>
      </view>
      <text class="nav-title">帮助中心</text>
      <view class="nav-right-placeholder"></view>
    </view>
  </view>

  <!-- 主内容 -->
  <scroll-view scroll-y class="main-scroll" style="height: calc(100vh - {{statusBarHeight + navBarHeight}}px); margin-top: {{statusBarHeight + navBarHeight}}px;">

    <!-- 搜索框 -->
    <view class="search-section">
      <view class="search-box">
        <view class="search-icon">
          <t-icon name="search" size="36rpx" color="#999" />
        </view>
        <input class="search-input" placeholder="搜索帮助内容" bindinput="onSearchInput" bindconfirm="onSearch" value="{{searchKeyword}}" placeholder-class="search-placeholder" />
        <view class="search-btn" bindtap="onSearch">搜索</view>
      </view>
    </view>

    <!-- 常见问题 -->
    <view class="section">
      <view class="section-title">常见问题</view>
      <view class="question-list">
        <view
          wx:for="{{filteredQuestions}}"
          wx:key="id"
          class="question-item"
          data-id="{{item.id}}"
          bindtap="onQuestionTap"
        >
          <view class="item-icon">
            <view class="custom-help-icon"></view>
          </view>
          <view class="item-content">
            <text class="question-title">{{item.title}}</text>
            <text class="question-preview" wx:if="{{!item.expanded}}">{{item.preview}}</text>
            <view class="question-answer" wx:if="{{item.expanded}}">{{item.answer}}</view>
          </view>
          <view class="item-arrow">
            <t-icon name="chevron-right" size="32rpx" color="#999" />
          </view>
        </view>
      </view>
    </view>

  </scroll-view>
</view>
