/* pages/help-center/help-center.wxss */

page {
  height: 100vh;
  background: #F5F5F5;
  overflow: hidden;
}

.container {
  height: 100%;
  width: 100%;
  padding: 0; /* 覆盖全局的 padding: 200rpx 0 */
  display: block; /* 覆盖全局的 flex 布局 */
  overflow: hidden;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: transparent;
}

.nav-content {
  width: 100%;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.nav-left {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 30px;
  height: 35px;
  background-image: url("data:image/svg+xml,%3Csvg width='30' height='35' viewBox='0 0 30 35' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12.5 11.6666L7.5 17.5M7.5 17.5L12.5 23.3333M7.5 17.5L22.5 17.5' stroke='%23000E08' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.nav-right-placeholder {
  width: 48rpx;
}

/* 主内容 */
.main-scroll {
  width: 100%;
}

/* 搜索区域 */
.search-section {
  padding: 24rpx 32rpx 16rpx 32rpx;
  background: transparent;
}

.search-box {
  height: 80rpx;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border-radius: 40rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.search-icon {
  margin-right: 12rpx;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-placeholder {
  color: #999;
}

.search-btn {
  width: 98rpx;
  height: 54rpx;
  background: linear-gradient(98.63deg, #7BDE3A 2.44%, #CFDF17 95.85%);
  border-radius: 27rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 区块 */
.section {
  margin-bottom: 16rpx;
  background: transparent;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  padding: 16rpx 32rpx 24rpx;
}

/* 问题列表 */
.question-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 0 32rpx 32rpx;
  padding: 0 24rpx;
  box-shadow: 4rpx 4rpx 10rpx rgba(0, 0, 0, 0.08);
}

.question-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.question-item:last-child {
  border-bottom: none;
}

.item-icon {
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.custom-help-icon {
  width: 48rpx;
  height: 48rpx;
  background-image: url("data:image/svg+xml,%3Csvg width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cg clip-path='url(%23clip0_459_493)'%3E%3Ccircle cx='12' cy='12' r='9' stroke='%2334C759' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3Crect x='12' y='16' width='0.01' height='0.01' stroke='%2334C759' stroke-width='3' stroke-linejoin='round'/%3E%3Cpath d='M10.5858 7.5856C10.9754 7.19597 11.4858 7.00071 11.9965 6.99982C12.5095 6.99892 13.0228 7.19418 13.4142 7.5856C13.8047 7.97613 14 8.48797 14 8.99982C14 9.51166 13.8047 10.0235 13.4142 10.414C13.0228 10.8054 12.5095 11.0007 11.9965 10.9998L12 11.9998' stroke='%2334C759' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/g%3E%3Cdefs%3E%3CclipPath id='clip0_459_493'%3E%3Crect width='24' height='24' fill='white'/%3E%3C/clipPath%3E%3C/defs%3E%3C/svg%3E");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}

.question-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  line-height: 40rpx;
  margin-bottom: 6rpx;
}

.question-preview {
  font-size: 24rpx;
  color: #999;
  line-height: 40rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.question-answer {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-top: 16rpx;
  padding: 20rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
  white-space: pre-line;
}

.item-arrow {
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
