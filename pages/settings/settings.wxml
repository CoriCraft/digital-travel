<view class="container">
  <!-- 导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="onBack">
        <view class="back-icon"></view>
      </view>
      <text class="nav-title">设置</text>
      <view class="nav-right-placeholder"></view>
    </view>
  </view>

  <!-- 主内容 -->
  <scroll-view scroll-y class="main-scroll" style="padding-top: calc({{statusBarHeight + navBarHeight}}px + 32rpx);">

    <!-- 隐私设置 -->
    <view class="section">
      <view class="section-title">隐私设置</view>
      <view class="setting-card">
        <view class="setting-item" bindtap="onPrivacyTap">
          <view class="setting-left">
            <t-icon name="lock-on" size="40rpx" color="#3ECE79" />
            <view class="setting-info">
              <text class="setting-label">隐私政策</text>
            </view>
          </view>
          <t-icon name="chevron-right" size="32rpx" color="#999" />
        </view>
        <view class="setting-divider"></view>
        <view class="setting-item" bindtap="onUserAgreementTap">
          <view class="setting-left">
            <t-icon name="user" size="40rpx" color="#3ECE79" />
            <view class="setting-info">
              <text class="setting-label">用户协议</text>
            </view>
          </view>
          <t-icon name="chevron-right" size="32rpx" color="#999" />
        </view>
      </view>
    </view>

    <!-- 缓存管理 -->
    <view class="section">
      <view class="section-title">缓存管理</view>
      <view class="setting-card">
        <view class="setting-item" bindtap="onClearCache">
          <view class="setting-left">
            <t-icon name="delete" size="40rpx" color="#3ECE79" />
            <view class="setting-info">
              <text class="setting-label">清除缓存</text>
              <text class="setting-desc">当前缓存：{{cacheSize}}</text>
            </view>
          </view>
          <t-icon name="chevron-right" size="32rpx" color="#999" />
        </view>
      </view>
    </view>

    <!-- 关于 -->
    <view class="section">
      <view class="section-title">关于</view>
      <view class="setting-card">
        <view class="setting-item" bindtap="onAboutTap">
          <view class="setting-left">
            <t-icon name="info-circle" size="40rpx" color="#3ECE79" />
            <view class="setting-info">
              <text class="setting-label">关于我们</text>
              <text class="setting-desc">版本号：{{version}}</text>
            </view>
          </view>
          <t-icon name="chevron-right" size="32rpx" color="#999" />
        </view>
        <view class="setting-divider"></view>
        <view class="setting-item" bindtap="onCheckUpdate">
          <view class="setting-left">
            <t-icon name="refresh" size="40rpx" color="#3ECE79" />
            <view class="setting-info">
              <text class="setting-label">检查更新</text>
            </view>
          </view>
          <t-icon name="chevron-right" size="32rpx" color="#999" />
        </view>
      </view>
    </view>

    <!-- 账号管理 -->
    <view class="section">
      <view class="section-title">账号管理</view>
      <view class="setting-card">
        <view class="setting-item" bindtap="onLogout">
          <view class="setting-left">
            <t-icon name="logout" size="40rpx" color="#FF4444" />
            <view class="setting-info">
              <text class="setting-label" style="color: #FF4444;">退出登录</text>
            </view>
          </view>
          <t-icon name="chevron-right" size="32rpx" color="#999" />
        </view>
      </view>
    </view>

    <!-- 底部间距 -->
    <view style="height: 40rpx;"></view>

  </scroll-view>
</view>
