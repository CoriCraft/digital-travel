/* pages/create-template/create-template.wxss */
.container {
  min-height: 100vh;
  position: relative;
  z-index: 1;
  display: block !important;
  align-items: unset !important;
  justify-content: unset !important;
  padding: 0 !important;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background-color: transparent;
  padding-top: var(--status-bar-height);
}

.nav-content {
  height: var(--nav-bar-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 30px;
  height: 35px;
  background-image: url("data:image/svg+xml,%3Csvg width='30' height='35' viewBox='0 0 30 35' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12.5 11.6666L7.5 17.5M7.5 17.5L12.5 23.3333M7.5 17.5L22.5 17.5' stroke='%23000E08' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.nav-right-placeholder {
  width: 80rpx;
}

/* 页面内容 */
.page-content {
  padding-top: calc(var(--status-bar-height) + var(--nav-bar-height) + 40rpx);
  padding-bottom: 80rpx;
}

.form-container {
  padding: 20rpx 64rpx;
}

/* 表单项卡片化 */
.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: #3E3E3E;
}

/* 自定义输入框 */
.custom-input-wrapper {
  background: #FFFFFF;
  border-radius: 26rpx;
  box-shadow: 2rpx 4rpx 12rpx rgba(0, 0, 0, 0.1);
  padding: 24rpx 20rpx;
  border: 2px solid red;
}

.custom-input {
  font-size: 28rpx;
  color: #333;
  width: 100%;
}

.custom-input::placeholder {
  color: #999;
}

/* 输入框、分类、标签的白色背景容器 */
.t-input, .t-textarea, .radio-group-container {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFFFF 100%) !important;
  border-radius: 26rpx !important;
  border: none !important;
  box-shadow: 2rpx 4rpx 12rpx rgba(0, 0, 0, 0.1);
  padding: 24rpx 20rpx !important;
  font-size: 28rpx !important;
  box-sizing: border-box !important;
}

/* 确保 placeholder 也是 28rpx */
.t-input__content, .t-textarea__content {
  font-size: 28rpx !important;
}

/* 模板描述文本框专属高度与字体样式 (对应Figma: 190px高, 16px字号, #9F9F9F) */
.desc-textarea {
  height: 380rpx !important;
}

/* 穿透修改 TDesign 内部的占位符和字数指示器颜色与字号 */
.desc-textarea .t-textarea__placeholder,
.desc-textarea .t-textarea__indicator {
  color: #9F9F9F !important;
  font-size: 32rpx !important;
}

/* 修改输入文字的字号 */
.desc-textarea .t-textarea__wrapper-inner {
  font-size: 32rpx !important;
}

.required {
  color: #FF4D4F;
  margin-left: 8rpx;
}

/* 分类选择样式定制 */
.radio-group-container {
  background: #FFFFFF;
  border-radius: 26rpx;
  box-shadow: 2rpx 4rpx 12rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

/* 彻底重置 TDesign 单选框的样式，使用官方 CSS 变量 */
.custom-radio {
  position: relative;
  --td-radio-font-size: 32rpx;
  --td-radio-font-color: #616161;
  --td-radio-icon-color: #CDCDCD;
  --td-radio-icon-size: 52rpx;
  --td-radio-bg-color: transparent;
}

/* 控制整体选项高度 (Figma: 55px = 110rpx) */
.custom-radio .t-radio {
  padding: 28rpx 20rpx !important;
}

/* 精准复原 Figma 中的局部线条：从文字左侧开始，颜色 #E2E2E2 */
.custom-radio:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 104rpx;
  right: 32rpx;
  height: 1px;
  background-color: #E2E2E2;
}

/* 标签输入 */
.tag-input-wrapper {
  margin-bottom: 24rpx;
}

/* 标签输入框的 placeholder 颜色 */
.tag-input-wrapper .t-input__placeholder {
  color: #9F9F9F !important;
  font-size: 32rpx !important;
}

/* 标签输入框内容文字 */
.tag-input-wrapper .t-input__content {
  font-size: 32rpx !important;
}

.add-tag-btn {
  padding: 0 24rpx;
  height: 66rpx;
  line-height: 66rpx;
  background: linear-gradient(98.63deg, #7BDE3A 2.44%, #CFDF17 95.85%);
  color: #fff;
  border-radius: 61rpx;
  font-size: 29rpx;
  font-weight: 500;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background-color: #fff;
  border: 1px solid #A6E22E;
  border-radius: 40rpx;
  color: #A6E22E;
  font-size: 28rpx;
}

/* 照片网格 */
.photos-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx;
  background-color: rgba(166, 226, 46, 0.9);
  color: #fff;
  font-size: 22rpx;
  text-align: center;
}

.photo-upload-btn {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  background-color: #fff;
  border: 2rpx dashed #BCBCBC;
  border-radius: 12rpx;
}

.upload-btn-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.upload-hint {
  font-size: 28rpx;
  color: #9F9F9F;
}

/* 提示信息 */
.form-tips {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  margin-bottom: 40rpx;
  background: transparent;
}

.tips-text {
  font-size: 28rpx;
  color: #75F34E;
  margin-left: 8rpx;
}

/* 提交按钮区域 */
.submit-section {
  display: flex;
  justify-content: center;
  padding: 0;
  margin-bottom: 60rpx;
}

/* 覆盖 TDesign 按钮的主题样式，还原渐变和字体 */
.submit-btn {
  background: linear-gradient(90deg, #80D73D 0%, #C3ED44 100%) !important;
  border: none !important;
  border-radius: 40rpx !important;
  color: #282828 !important;
  font-size: 36rpx !important;
  font-weight: 500 !important;
  width: 640rpx !important;
  height: 98rpx !important;
}