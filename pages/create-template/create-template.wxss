/* pages/create-template/create-template.wxss */
.container {
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background-color: transparent;
  padding-top: var(--status-bar-height);
}

.nav-content {
  height: var(--nav-bar-height);
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

/* 页面内容 */
.page-content {
  padding-top: calc(var(--status-bar-height) + var(--nav-bar-height));
  padding-bottom: 40rpx;
}

.form-container {
  padding: 40rpx 32rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 48rpx;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.required {
  color: #82F45F;
  margin-right: 8rpx;
}

/* 标签输入 */
.tag-input-wrapper {
  margin-bottom: 24rpx;
}

.add-tag-btn {
  padding: 8rpx 24rpx;
  background-color: #82F45F;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background-color: #fff;
  border: 1px solid #82F45F;
  border-radius: 40rpx;
  color: #82F45F;
  font-size: 28rpx;
}

/* 照片网格 */
.photos-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx;
  background-color: rgba(130, 244, 95, 0.9);
  color: #fff;
  font-size: 22rpx;
  text-align: center;
}

.photo-upload-btn {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  background-color: #f5f5f5;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
}

.upload-btn-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.upload-hint {
  font-size: 22rpx;
  color: #999;
}

/* 提交按钮 */
.submit-section {
  margin-top: 64rpx;
  margin-bottom: 32rpx;
}

/* 提示信息 */
.form-tips {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx;
  background-color: rgba(130, 244, 95, 0.1);
  border-radius: 12rpx;
}

.tips-text {
  font-size: 28rpx;
  color: #82F45F;
}
