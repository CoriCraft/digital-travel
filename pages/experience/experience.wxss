/* pages/experience/experience.wxss */
page {
  background: #f5fcf7;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
}

/* --- 顶部导航 --- */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #d0f2dc 0%, #d4f4dd 100%);
  z-index: 999;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
}

.nav-right {
  display: flex;
  align-items: center;
}

.avatar-circle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.6);
  border: 1px solid rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.page-container {
  /* 整个页面的背景渐变 */
  background: linear-gradient(180deg, #d4f4dd 0%, #ffffff 40%);
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 60rpx;
}

/* --- 搜索胶囊 --- */
.search-section {
  padding: 16rpx 24rpx;
  margin-bottom: 10rpx;
}

.search-capsule {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  height: 84rpx;
  border-radius: 42rpx;
  padding: 0 10rpx 0 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(168, 209, 178, 0.25);
}

.search-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.location-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.search-btn {
  background: #99d930;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 12rpx 36rpx;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 10rpx rgba(153, 217, 48, 0.3);
}

/* --- 网格布局 (高度精确控制) --- */
.grid-section {
  display: flex;
  padding: 0 24rpx;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.grid-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.bento-card {
  border-radius: 24rpx;
  padding: 20rpx;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

/* 左侧：休闲玩乐 (300rpx) */
.card-leisure {
  background: linear-gradient(135deg, #e3f8d6 0%, #c8efb6 100%);
  height: 300rpx; 
  display: flex;
  flex-direction: column;
}

.card-tag-hot {
  position: absolute;
  top: 0;
  left: 90rpx;
  background: #ff8c00;
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 0 0 10rpx 10rpx;
  z-index: 10;
  font-weight: bold;
}

.card-header {
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2e4422;
  display: block;
}

.card-sub {
  font-size: 22rpx;
  color: #5c7a4a;
}

.leisure-imgs {
  flex: 1;
  display: flex;
  gap: 12rpx;
}

.img-placeholder {
  background: rgba(255,255,255,0.6);
  border-radius: 12rpx;
  width: 50%;
  height: 100%;
}

/* 左侧：景点游玩 (180rpx) -> 左列总高 500rpx */
.card-scenic {
  background: #d4f4dd;
  height: 180rpx; 
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.scenic-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.action-pill {
  background: #ff9f43;
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.scenic-imgs {
  display: flex;
  gap: 12rpx;
  height: 80rpx;
}

.img-mini {
  flex: 1;
  background: rgba(255,255,255,0.6);
  border-radius: 8rpx;
  height: 100%;
}

/* 右侧：酒店民宿 (320rpx) */
.card-hotel {
  background: linear-gradient(135deg, #e0fbf0 0%, #c4f0e0 100%);
  height: 320rpx;
  display: flex;
  flex-direction: column;
}

.card-sub-blue {
  font-size: 22rpx;
  color: #4a8b7a;
}

.hotel-imgs {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  height: 100%; 
}

.img-tall {
  flex: 1;
  background: rgba(255,255,255,0.6);
  border-radius: 12rpx;
  height: 100%;
}

/* 右侧：特色农家菜 (160rpx) -> 右列总高 500rpx */
.card-food {
  background: #fff;
  height: 160rpx;
  display: flex;
  flex-direction: column;
}

.food-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #4a8b7a;
  margin-bottom: 12rpx;
  display: block;
}

.food-imgs {
  flex: 1;
  display: flex;
  gap: 12rpx;
}

.img-food {
  flex: 1;
  background: #f0f0f0;
  border-radius: 12rpx;
}

/* --- Tab 栏 --- */
.tab-section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tab-item {
  font-size: 28rpx;
  color: #666;
  position: relative;
  font-weight: 500;
}

.tab-item.active {
  color: #000;
  font-size: 32rpx;
  font-weight: 800;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 6rpx;
  background: #99d930;
  border-radius: 4rpx;
}

/* --- 推荐卡片 (核心操作区) --- */
.feed-list {
  padding: 0 24rpx;
}

.feed-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: visible; /* 允许阴影溢出 */
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.06);
  margin-bottom: 40rpx;
}

.feed-img-box {
  width: 100%;
  height: 320rpx;
  background: #eee;
  border-radius: 24rpx 24rpx 0 0;
}

.feed-info {
  padding: 24rpx;
  position: relative; /* 关键：相对定位基准 */
}

.info-top {
  margin-bottom: 12rpx;
}

.feed-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #333;
}

.feed-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 定位行 */
.feed-loc {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.icon-location {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.loc-text {
  font-size: 24rpx;
  color: #999;
}

/* 底部操作区 */
.bottom-action-area {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 全宽导航按钮 */
.btn-nav-full {
  flex: 1; /* 占据剩余空间 */
  height: 88rpx;
  background: linear-gradient(90deg, #d4f4dd 0%, #bbf7c8 100%); /* 浅绿渐变 */
  color: #2e4422;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx; /* 圆润的胶囊形 */
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(46, 68, 34, 0.08);
}

/* 关键：悬浮帮助按钮 (复现设计图) */
.float-help-bubble {
  position: absolute; /* 绝对定位 */
  right: 24rpx;       /* 距离右侧边距 */
  bottom: 130rpx;     /* 距离底部的高度 (位于导航按钮上方) */
  
  width: 96rpx;       /* 尺寸稍微加大一点以匹配设计图的通透感 */
  height: 96rpx;
  background: #ffffff;
  
  /* 超椭圆/大圆角设计 */
  border-radius: 36rpx; 
  
  /* 弥散阴影：颜色淡，扩散半径大 */
  box-shadow: 0 8rpx 24rpx rgba(142, 217, 77, 0.25);
  
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

/* 新增代码：控制 SVG 图标的大小 */
.help-icon-svg {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 2rpx; /* 稍微拉开一点文字距离 */
}

.help-text {
  font-size: 20rpx;
  color: #A3D975; /* 比图标稍浅的绿色 */
  font-weight: 600;
  margin-top: 2rpx;
  line-height: 1;
}