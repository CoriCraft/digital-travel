/* pages/experience/experience.wxss */

/* --- 顶部导航 --- */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: transparent;
  z-index: 999;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 100%;
}

.nav-left,
.nav-right {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.nav-right {
  justify-content: flex-end;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 60rpx;
  position: relative;
  z-index: 1;
}

/* --- 网格布局 (高度精确控制) --- */
.grid-section {
  display: flex;
  padding: 0 24rpx;
  gap: 20rpx;
  margin-bottom: 30rpx;
  min-height: 500rpx; /* 确保有足够高度 */
  overflow: hidden; /* 防止子元素溢出 */
}

.grid-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  min-width: 0; /* 关键：允许flex子元素收缩 */
  max-width: 50%; /* 限制最大宽度 */
}

.right-col {
  /* 调试：添加背景色看看是否存在 */
  /* background: rgba(255, 0, 0, 0.1); */
}

.bento-card {
  border-radius: 24rpx;
  padding: 20rpx;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

/* 左侧：休闲玩乐 (300rpx) */
.card-leisure {
  background: linear-gradient(135deg, rgba(143, 241, 236, 0.3) 0%, rgba(130, 244, 95, 0.3) 100%);
  height: 300rpx;
  display: flex;
  flex-direction: column;
}

.card-tag-hot {
  position: absolute;
  top: 0;
  left: 90rpx;
  background: #ff8c00;
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 0 0 10rpx 10rpx;
  z-index: 10;
  font-weight: bold;
}

.card-header {
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2e4422;
  display: block;
}

.card-sub {
  font-size: 22rpx;
  color: #5c7a4a;
}

.leisure-imgs {
  flex: 1;
  display: flex;
  gap: 12rpx;
  min-height: 0; /* 防止flex子元素溢出 */
}

.img-placeholder {
  background: rgba(255,255,255,0.6);
  border-radius: 12rpx;
  width: 50%;
  height: 100%;
  overflow: hidden;
  flex-shrink: 0; /* 防止收缩 */
}

.img-placeholder image {
  width: 100%;
  height: 100%;
  display: block; /* 防止图片底部空隙 */
}

/* 左侧：景点游玩 (180rpx) -> 左列总高 500rpx */
.card-scenic {
  background: rgba(143, 241, 236, 0.2);
  height: 180rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.scenic-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.action-pill {
  background: #ff9f43;
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.scenic-imgs {
  display: flex;
  gap: 12rpx;
  height: 80rpx;
  min-height: 0;
}

.img-mini {
  flex: 1;
  background: rgba(255,255,255,0.6);
  border-radius: 8rpx;
  height: 100%;
  overflow: hidden;
  flex-shrink: 0;
}

.img-mini image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 右侧：酒店民宿 (320rpx) */
.card-hotel {
  background: linear-gradient(135deg, rgba(143, 241, 236, 0.25) 0%, rgba(130, 244, 95, 0.25) 100%);
  height: 320rpx;
  display: flex;
  flex-direction: column;
}

.card-sub-blue {
  font-size: 22rpx;
  color: #4a8b7a;
}

.hotel-imgs {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  height: 100%;
  min-height: 0;
}

.img-tall {
  flex: 1;
  background: rgba(255,255,255,0.6);
  border-radius: 12rpx;
  height: 100%;
  overflow: hidden;
  flex-shrink: 0;
}

.img-tall image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 右侧：特色农家菜 (160rpx) -> 右列总高 500rpx */
.card-food {
  background: #fff;
  height: 160rpx;
  display: flex;
  flex-direction: column;
}

.food-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #4a8b7a;
  margin-bottom: 12rpx;
  display: block;
}

.food-imgs {
  flex: 1;
  display: flex;
  gap: 12rpx;
  min-height: 0;
}

.img-food {
  flex: 1;
  background: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  height: 100%;
}

.img-food image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

/* --- Tab 栏 --- */
.tab-section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tab-item {
  font-size: 28rpx;
  color: #666;
  position: relative;
  font-weight: 500;
}

.tab-item.active {
  color: #000;
  font-size: 32rpx;
  font-weight: 800;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 6rpx;
  background: #82F45F;
  border-radius: 4rpx;
}

/* --- 推荐卡片 (核心操作区) --- */
.feed-list {
  padding: 0 24rpx;
}

.feed-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: visible; /* 允许阴影溢出 */
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.06);
  margin-bottom: 40rpx;
}

.feed-img-box {
  width: 100%;
  height: 320rpx;
  background: #eee;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  position: relative;
}

/* 距离标签 */
.distance-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10rpx);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  z-index: 10;
}

/* 热门标签 */
.hot-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8c42 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
  z-index: 10;
}

.feed-img {
  width: 100%;
  height: 100%;
}

/* 加载状态 */
.loading-more,
.no-more,
.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  font-size: 28rpx;
  color: #999;
}

.feed-info {
  padding: 24rpx;
}

.info-top {
  margin-bottom: 12rpx;
}

.feed-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #333;
}

.feed-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 定位行 */
.feed-loc {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.icon-location {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.loc-text {
  font-size: 24rpx;
  color: #999;
}

/* 底部操作区 */
.bottom-action-area {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 全宽导航按钮 */
.btn-nav-full {
  flex: 1; /* 占据剩余空间 */
  height: 88rpx;
  background: linear-gradient(90deg, rgba(143, 241, 236, 0.4) 0%, rgba(130, 244, 95, 0.4) 100%);
  color: #2e4422;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx; /* 圆润的胶囊形 */
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(46, 68, 34, 0.08);
}

/* 关键：悬浮帮助按钮 (全局固定定位) */
.float-help-bubble {
  position: fixed; /* 固定定位 */
  right: 24rpx;    /* 距离右侧边距 */
  bottom: 180rpx;  /* 距离底部的高度 (避开tabbar) */

  width: 96rpx;
  height: 96rpx;
  background: #ffffff;

  /* 超椭圆/大圆角设计 */
  border-radius: 36rpx;

  /* 弥散阴影：颜色淡，扩散半径大 */
  box-shadow: 0 8rpx 24rpx rgba(142, 217, 77, 0.25);

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999; /* 确保在最上层 */
}

/* 新增代码：控制 SVG 图标的大小 */
.help-icon-svg {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 2rpx; /* 稍微拉开一点文字距离 */
}

.help-text {
  font-size: 20rpx;
  color: #82F45F;
  font-weight: 600;
  margin-top: 2rpx;
  line-height: 1;
}