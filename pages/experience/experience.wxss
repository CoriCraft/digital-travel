}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 5rpx;
  background: linear-gradient(90deg, #6ABD16 0%, #DFE531 100%);
  border-radius: 4rpx;
  box-shadow: 0 4rpx 4rpx rgba(121, 198, 53, 0.2);
}

