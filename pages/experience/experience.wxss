}

.custom-search-bar {
  height: 80rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.search-icon {
  margin-right: 12rpx;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-placeholder {
  color: #999;
}

.search-btn {
  width: 98rpx;
  height: 54rpx;
  background: linear-gradient(98.63deg, #7BDE3A 2.44%, #CFDF17 95.85%);
  border-radius: 27rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 60rpx;
  position: relative;
  z-index: 1;
}

/* --- ç¼ƒæˆžç‰¸ç”¯å†¨çœ¬ (æ¥‚æ¨ºå®³ç»®å‰§â€˜éŽºÑƒåŸ—) --- */
.grid-section {
  display: flex;
  padding: 0 32rpx;
  gap: 20rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.grid-col {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  min-width: 0;
}

.left-col {
  flex: 1.35;
}

.right-col {
  flex: 1;
}

.bento-card {
  border-radius: 24rpx;
  padding: 20rpx;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

/* å®¸ï¸¿æ™¶é”›æ°«ç´¤é—‚èŒ¬å¸ºæ¶”?(300rpx) */
.card-leisure {
  position: relative;
  height: auto;
  background-color: transparent;
  padding: 0 !important;
  box-shadow: none !important;
  overflow: hidden;
}

/* 透明占位层，比 box 稍大，用于容纳超出的 HOT 标签 */
.leisure-overflow-container {
  position: absolute;
  top: -50rpx;
  left: -20rpx;
  right: -20rpx;
  bottom: -20rpx;
  z-index: 10;
  pointer-events: none;
}

.leisure-overflow-container .card-tag-hot {
  pointer-events: auto;
}

/* 异形 SVG 背景 - 使用 image 标签 */
.leisure-bg-svg {
  position: absolute;
  top: -5%;
  left: 0;
  width: 100%;
  height: 110%;
  z-index: 1;
}

/* 叠加的半透明高光层 (Rectangle 92) */
.card-leisure::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(282.98deg, rgba(196, 237, 68, 0.4) 6.29%, rgba(124, 214, 61, 0.4) 102.49%);
  border-radius: 24rpx;
  z-index: 1;
  pointer-events: none; /* 防止遮挡点击事件 */
}

/* 新增：内容包裹层，重写原有布局属性 */
.leisure-content {
  position: relative;
  z-index: 2; /* 提高层级，确保内容显示在高光层之上 */
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

.card-tag-hot {
  position: absolute;
  top: 56rpx;
  left: 240rpx;
  width: 96rpx;
  height: 40rpx;
  background: linear-gradient(272.68deg, #FCAE41 3.55%, #FF8100 96.45%);
  border-radius: 26rpx;
  transform: rotate(11.04deg);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
  font-weight: 900;
  font-style: italic;
  z-index: 10;
}

.card-header {
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #282828;
  display: block;
}

.card-sub {
  font-size: 22rpx;
  color: #558F29;
}

.leisure-imgs {
  flex: 1;
  display: flex;
  gap: 12rpx;
  min-height: 0; /* é˜²æ­¢flexå­å…ƒç´ æº¢å‡º */
}

.img-placeholder {
