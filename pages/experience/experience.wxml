<view class="custom-nav" style="padding-top:{{statusBarHeight}}px; height:{{navBarHeight}}px;">
  <view class="nav-content">
    <view class="nav-left">
      <t-icon name="home" size="48rpx" color="#333" />
    </view>
    <view class="nav-title">线下体验</view>
    <view class="nav-right">
      <!-- 右侧图标已移除 -->
    </view>
  </view>
</view>

<view class="page-container" style="padding-top: {{statusBarHeight + navBarHeight}}px;">

  <!-- 搜索框 -->
  <search-bar
    placeholder="搜索地点、美食、景点..."
    value="{{searchKeyword}}"
    bind:input="onSearchInput"
    bind:search="onSearch"
  />

  <view class="grid-section">
    <view class="grid-col left-col">
      <view class="bento-card card-leisure" bindtap="onBentoCardTap" data-type="leisure">
        <view class="card-tag-hot">HOT</view>
        <view class="card-header">
          <text class="card-title">休闲玩乐</text>
          <text class="card-sub">精品推荐/吃喝玩乐</text>
        </view>
        <view class="leisure-imgs">
          <image wx:if="{{leisureLocations[0]}}" class="img-placeholder left" src="{{leisureLocations[0].coverImage}}" mode="aspectFill" catchtap="onBentoImageTap" data-id="{{leisureLocations[0]._id}}" />
          <view wx:else class="img-placeholder left"></view>
          <image wx:if="{{leisureLocations[1]}}" class="img-placeholder right" src="{{leisureLocations[1].coverImage}}" mode="aspectFill" catchtap="onBentoImageTap" data-id="{{leisureLocations[1]._id}}" />
          <view wx:else class="img-placeholder right"></view>
        </view>
      </view>

      <view class="bento-card card-scenic" bindtap="onBentoCardTap" data-type="scenic">
        <view class="scenic-header">
          <text class="card-title">景点游玩</text>
          <view class="action-pill">马上看看 ></view>
        </view>
        <view class="scenic-imgs">
          <image wx:if="{{scenicLocations[0]}}" class="img-mini" src="{{scenicLocations[0].coverImage}}" mode="aspectFill" catchtap="onBentoImageTap" data-id="{{scenicLocations[0]._id}}" />
          <view wx:else class="img-mini"></view>
          <image wx:if="{{scenicLocations[1]}}" class="img-mini" src="{{scenicLocations[1].coverImage}}" mode="aspectFill" catchtap="onBentoImageTap" data-id="{{scenicLocations[1]._id}}" />
          <view wx:else class="img-mini"></view>
          <image wx:if="{{scenicLocations[2]}}" class="img-mini" src="{{scenicLocations[2].coverImage}}" mode="aspectFill" catchtap="onBentoImageTap" data-id="{{scenicLocations[2]._id}}" />
          <view wx:else class="img-mini"></view>
        </view>
      </view>
    </view>

    <view class="grid-col right-col">
      <view class="bento-card card-hotel" bindtap="onBentoCardTap" data-type="hotel">
        <view class="card-header">
          <text class="card-title">酒店民宿</text>
          <text class="card-sub-blue">精品民宿/舒适酒店</text>
        </view>
        <view class="hotel-imgs">
          <image wx:if="{{hotelLocations[0]}}" class="img-tall" src="{{hotelLocations[0].coverImage}}" mode="aspectFill" catchtap="onBentoImageTap" data-id="{{hotelLocations[0]._id}}" />
          <view wx:else class="img-tall"></view>
          <image wx:if="{{hotelLocations[1]}}" class="img-tall" src="{{hotelLocations[1].coverImage}}" mode="aspectFill" catchtap="onBentoImageTap" data-id="{{hotelLocations[1]._id}}" />
          <view wx:else class="img-tall"></view>
        </view>
      </view>

      <view class="bento-card card-food" bindtap="onBentoCardTap" data-type="food">
          <text class="food-title">特色农家菜</text>
          <view class="food-imgs">
            <image wx:if="{{foodLocations[0]}}" class="img-food" src="{{foodLocations[0].coverImage}}" mode="aspectFill" catchtap="onBentoImageTap" data-id="{{foodLocations[0]._id}}" />
            <view wx:else class="img-food"></view>
            <image wx:if="{{foodLocations[1]}}" class="img-food" src="{{foodLocations[1].coverImage}}" mode="aspectFill" catchtap="onBentoImageTap" data-id="{{foodLocations[1]._id}}" />
            <view wx:else class="img-food"></view>

          </view>
      </view>
    </view>
  </view>

  <view class="tab-section">
    <view class="tab-item {{currentCategory === 0 ? 'active' : ''}}" bindtap="onCategoryChange" data-value="0">推荐</view>
    <view class="tab-item {{currentCategory === 1 ? 'active' : ''}}" bindtap="onCategoryChange" data-value="1">附近</view>
    <view class="tab-item {{currentCategory === 2 ? 'active' : ''}}" bindtap="onCategoryChange" data-value="2">住宿</view>
    <view class="tab-item {{currentCategory === 3 ? 'active' : ''}}" bindtap="onCategoryChange" data-value="3">美食</view>
    <view class="tab-item {{currentCategory === 4 ? 'active' : ''}}" bindtap="onCategoryChange" data-value="4">景点</view>
    <view class="tab-item {{currentCategory === 5 ? 'active' : ''}}" bindtap="onCategoryChange" data-value="5">玩乐</view>
  </view>

  <view class="feed-list">
    <view class="feed-card" wx:for="{{feedList}}" wx:key="_id" bindtap="onViewDetail" data-id="{{item._id}}">
      <view class="feed-img-box">
        <image wx:if="{{item.coverImage}}" class="feed-img" src="{{item.coverImage}}" mode="aspectFill" style="width: 100%; height: 100%;" lazy-load="{{true}}" />
        <!-- 热门标签 -->
        <view wx:if="{{item.isHot}}" class="hot-badge">🔥 热门</view>
        <!-- 距离标签 -->
        <view wx:if="{{item.distanceText}}" class="distance-badge">{{item.distanceText}}</view>
      </view>

      <view class="feed-info">
        <view class="info-top">
          <text class="feed-title">{{item.name}}</text>
        </view>
        <view class="feed-desc">{{item.description}}</view>

        <view class="feed-loc">
          <image class="icon-location" src="data:image/svg+xml;base64," />
          <text class="loc-text">{{item.address}}</text>
        </view>
      </view>
    </view>

    <view class="loading-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <view class="no-more" wx:if="{{!hasMore && feedList.length > 0}}">
      <text>没有更多了</text>
    </view>

    <view class="empty-tip" wx:if="{{!loading && feedList.length === 0}}">
      <text>暂无数据</text>
    </view>
  </view>

  <!-- 全局悬浮帮助按钮 -->
  <view class="float-help-bubble">
    <image class="help-icon-svg" src="data:image/svg+xml;base64," />
    <text class="help-text">帮助</text>
  </view>

</view>