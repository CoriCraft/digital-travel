/* pages/photo-preview/photo-preview.wxss */
.preview-container {
  width: 100vw;
  height: 100vh;
  position: relative;
}

.photo-swiper {
  width: 100%;
  height: 100%;
}

.preview-image {
  width: 100%;
  height: 100%;
}

/* 顶部工具栏 */
.top-toolbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-top: calc(var(--status-bar-height, 0px) + 20rpx);
  background: linear-gradient(to bottom, rgba(0,0,0,0.6), transparent);
  z-index: 100;
}

.toolbar-left {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.toolbar-center {
  flex: 1;
  display: flex;
  justify-content: center;
}

.photo-index {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
}

.toolbar-right {
  width: 80rpx;
}

/* 发布者信息 */
.author-info {
  position: fixed;
  top: calc(var(--status-bar-height, 0px) + 140rpx);
  left: 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 24rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 40rpx;
  z-index: 100;
}

.author-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.author-name {
  font-size: 28rpx;
  color: #fff;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 底部操作栏 */
.bottom-toolbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
  z-index: 100;
}

.toolbar-actions {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.action-text {
  font-size: 24rpx;
  color: #fff;
}
