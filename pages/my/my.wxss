/* pages/my/my.wxss */

/* Design Specification:
   - Aesthetic: Organic/natural with Art deco/geometric accents
   - Colors: Forest green (#2C5530), Golden sand (#D4A574), Natural linen (#F5F1E8)
   - Typography: Noto Serif SC, Source Han Sans CN
   - Layout: Asymmetric diagonal flow with overlapping cards
*/

.page-container {
  min-height: 100vh;
  background: linear-gradient(165deg, #F5F1E8 0%, #E8DCC8 100%);
  position: relative;
  overflow: hidden;
}

/* Custom Navigation Bar */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: rgba(44, 85, 48, 0.95);
  backdrop-filter: blur(10px);
  z-index: 1000;
  border-bottom: 1px solid rgba(212, 165, 116, 0.3);
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.navbar-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 18px;
  font-weight: 500;
  color: #F5F1E8;
  letter-spacing: 2px;
}

/* Loading State */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding-top: 100px;
}

.loading-spinner {
  width: 40px;
  height: 40px;
  border: 3px solid rgba(44, 85, 48, 0.2);
  border-top-color: #2C5530;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 16px;
  font-family: 'Source Han Sans CN', sans-serif;
  font-size: 14px;
  color: #2C5530;
  opacity: 0.7;
}

/* Profile Content */
.profile-content {
  padding: 100px 24px 100px;
  position: relative;
  z-index: 1;
}

/* Avatar Section - Asymmetric positioning */
.avatar-section {
  display: flex;
  justify-content: flex-start;
  margin-left: 40px;
  margin-bottom: 48px;
  transform: translateX(-10px);
}

.avatar-container {
  position: relative;
  transform: rotate(-3deg);
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: rotate(-3deg) translateY(0px); }
  50% { transform: rotate(-3deg) translateY(-8px); }
}

.avatar-circle {
  width: 100px;
  height: 100px;
  background: linear-gradient(135deg, #2C5530 0%, #3D7040 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 8px 24px rgba(44, 85, 48, 0.25),
    0 0 0 4px rgba(212, 165, 116, 0.3);
  position: relative;
  overflow: hidden;
}

.avatar-circle::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  transform: rotate(45deg);
  animation: shimmer 3s linear infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
  100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
}

.avatar-icon {
  font-family: 'Noto Serif SC', serif;
  font-size: 36px;
  font-weight: 500;
  color: #F5F1E8;
  position: relative;
  z-index: 1;
}

.avatar-badge {
  position: absolute;
  bottom: 2px;
  right: 2px;
  width: 24px;
  height: 24px;
  background: #D4A574;
  border-radius: 50%;
  border: 3px solid #F5F1E8;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

/* Info Cards - Diagonal flow with overlap */
.info-cards {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.info-card {
  background: #FFFFFF;
  border-radius: 16px;
  padding: 24px;
  box-shadow:
    0 4px 20px rgba(44, 85, 48, 0.08),
    0 1px 4px rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
}

/* Primary Card - Rotated and offset */
.primary-card {
  transform: rotate(-1deg) translateX(-8px);
  border-left: 4px solid #D4A574;
  animation: slideInLeft 0.6s ease-out;
}

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: rotate(-1deg) translateX(-30px);
  }
  to {
    opacity: 1;
    transform: rotate(-1deg) translateX(-8px);
  }
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
  position: relative;
}

.card-title {
  font-family: 'Noto Serif SC', serif;
  font-size: 16px;
  font-weight: 600;
  color: #2C5530;
  letter-spacing: 1px;
}

.card-decoration {
  width: 40px;
  height: 3px;
  background: linear-gradient(90deg, #D4A574 0%, transparent 100%);
  border-radius: 2px;
}

.card-content {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.info-row {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 8px 0;
  border-bottom: 1px solid rgba(44, 85, 48, 0.1);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-family: 'Source Han Sans CN', sans-serif;
  font-size: 12px;
  color: #8B8B8B;
  letter-spacing: 0.5px;
}

.info-value {
  font-family: 'Source Han Sans CN', sans-serif;
  font-size: 13px;
  color: #1A1A1A;
  word-break: break-all;
  line-height: 1.6;
}

/* Secondary Card - Stats with dividers */
.secondary-card {
  transform: rotate(0.5deg) translateX(8px);
  animation: slideInRight 0.6s ease-out 0.1s both;
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: rotate(0.5deg) translateX(30px);
  }
  to {
    opacity: 1;
    transform: rotate(0.5deg) translateX(8px);
  }
}

.secondary-card .card-content {
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  gap: 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  flex: 1;
}

.stat-number {
  font-family: 'Source Han Sans CN', sans-serif;
  font-size: 28px;
  font-weight: 600;
  color: #2C5530;
}

.stat-label {
  font-family: 'Noto Serif SC', serif;
  font-size: 11px;
  color: #8B8B8B;
  letter-spacing: 0.5px;
}

.stat-divider {
  width: 1px;
  height: 40px;
  background: linear-gradient(180deg, transparent 0%, rgba(44, 85, 48, 0.2) 50%, transparent 100%);
}

/* Status Card */
.status-card {
  transform: rotate(-0.5deg) translateX(-4px);
  background: linear-gradient(135deg, #2C5530 0%, #3D7040 100%);
  animation: slideInUp 0.6s ease-out 0.2s both;
}

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: rotate(-0.5deg) translateX(-4px) translateY(20px);
  }
  to {
    opacity: 1;
    transform: rotate(-0.5deg) translateX(-4px) translateY(0);
  }
}

.status-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}

.status-dot {
  width: 10px;
  height: 10px;
  background: #D4A574;
  border-radius: 50%;
  box-shadow: 0 0 0 4px rgba(212, 165, 116, 0.3);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    box-shadow: 0 0 0 4px rgba(212, 165, 116, 0.3);
  }
  50% {
    box-shadow: 0 0 0 8px rgba(212, 165, 116, 0.1);
  }
}

.status-text {
  font-family: 'Noto Serif SC', serif;
  font-size: 14px;
  font-weight: 500;
  color: #F5F1E8;
  letter-spacing: 1px;
}

.status-description {
  font-family: 'Source Han Sans CN', sans-serif;
  font-size: 12px;
  color: rgba(245, 241, 232, 0.7);
  margin-left: 18px;
}

/* Decorative Patterns - Art deco geometric elements */
.decorative-pattern {
  position: absolute;
  border: 2px solid rgba(212, 165, 116, 0.15);
  pointer-events: none;
  z-index: 0;
}

.pattern-1 {
  top: 140px;
  right: 20px;
  width: 120px;
  height: 120px;
  border-radius: 50%;
  transform: rotate(15deg);
  animation: rotatePattern 20s linear infinite;
}

.pattern-2 {
  bottom: 100px;
  left: 30px;
  width: 80px;
  height: 80px;
  border-radius: 8px;
  transform: rotate(-25deg);
  animation: rotatePattern 15s linear infinite reverse;
}

@keyframes rotatePattern {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Ensure content is above decorative elements */
.info-cards {
  position: relative;
  z-index: 2;
}
