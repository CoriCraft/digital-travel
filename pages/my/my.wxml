<view class="container">
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left">
        <t-icon name="home" size="48rpx" color="#333" />
      </view>
      <view class="nav-title">我的</view>
      <view class="nav-right">
        <!-- 右侧图标已移除 -->
      </view>
    </view>
  </view>

  <view class="main-content" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    
    <view class="user-card-wrap">
      <view class="user-card">
        <view class="user-header">
          <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image class="avatar" src="{{userAvatar}}" mode="aspectFill"></image>
          </button>
          <view class="user-meta">
            <view class="nickname-row" bindtap="onEditNickname">
              <text class="nickname">{{userName}}</text>
              <view class="icon-edit"></view>
            </view>
            <text class="user-id">{{userPhone}}</text>
          </view>
        </view>
        <view class="card-divider"></view>
        <view class="stats-row">
          <view class="stat-box">
            <text class="stat-num">{{templateCount}}</text>
            <text class="stat-label">打卡拍摄点</text>
          </view>
          <view class="stat-vertical-line"></view>
          <view class="stat-box">
            <text class="stat-num">{{experienceCount}}</text>
            <text class="stat-label">注册天数</text>
          </view>
        </view>
      </view>
    </view>

    <view class="menu-section">
      <view class="menu-card" bindtap="navigateToProducts">
        <view class="icon-box bg-pale-green">
          <view class="icon-img icon-photo"></view>
        </view>
        <view class="menu-info">
          <text class="menu-title">我的作品</text>
          <text class="menu-desc">已发布、草稿箱</text>
        </view>
        <view class="icon-arrow"></view>
      </view>

      <view class="menu-card" bindtap="navigateToCollect">
        <view class="icon-box bg-pale-green">
          <view class="icon-img icon-heart"></view>
        </view>
        <view class="menu-info">
          <text class="menu-title">我的收藏</text>
          <text class="menu-desc">模板、照片集、商品、地点</text>
        </view>
        <view class="icon-arrow"></view>
      </view>

      <view class="menu-card" bindtap="navigateToMessages">
        <view class="icon-box bg-pale-green">
          <view class="icon-img icon-message"></view>
          <view class="message-badge-icon" wx:if="{{unreadCount > 0}}">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
        </view>
        <view class="menu-info">
          <text class="menu-title">消息中心</text>
          <text class="menu-desc">系统通知、互动消息</text>
        </view>
        <view class="icon-arrow"></view>
      </view>
    </view>

    <view class="list-section">
      <view class="list-card">
        <view class="list-row" bindtap="navigateToHelp">
          <view class="list-icon icon-help"></view>
          <text class="list-name">帮助中心</text>
          <view class="icon-arrow-small"></view>
        </view>

        <view class="list-row" bindtap="navigateToService">
          <view class="list-icon icon-feedback"></view>
          <text class="list-name">意见反馈</text>
          <view class="icon-arrow-small"></view>
        </view>

        <view class="list-row no-border" bindtap="navigateToSettings">
          <view class="list-icon icon-settings"></view>
          <text class="list-name">设置</text>
          <view class="icon-arrow-small"></view>
        </view>
      </view>
    </view>

  </view>
</view>