<!-- pages/template-detail/template-detail.wxml -->
<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="--status-bar-height: {{statusBarHeight}}px; --nav-bar-height: {{navBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="onBack">
        <view class="back-icon"></view>
        <text class="nav-title">{{template.name || '模板详情'}}</text>
      </view>
    </view>
  </view>

  <!-- 页面内容 -->
  <view class="page-content">
    <!-- 模板信息卡片 -->
    <view class="template-header" wx:if="{{template}}">
      <image
        class="template-cover"
        src="{{template.cover}}"
        mode="aspectFill"
        show-menu-by-longpress="{{false}}"
      />
    </view>

    <view class="template-info-box" wx:if="{{template}}">
      <view class="template-title-row">
        <text class="template-name">{{template.name}}</text>
        <view class="official-badge" wx:if="{{template.isOfficial}}">官方</view>
      </view>
      <view class="template-stats">
        <view class="stat-item">
          <t-icon name="star-filled" size="32rpx" color="{{isFavorite ? '#FFD700' : '#DADADA'}}" />
          <text class="stat-text">{{template.favoriteCount || 0}}</text>
        </view>
        <view class="stat-item">
          <t-icon name="heart-filled" size="32rpx" color="{{isLiked ? '#FF4444' : '#DADADA'}}" />
          <text class="stat-text">{{template.likeCount || 0}}</text>
        </view>
        <view class="stat-item">
          <t-icon name="browse" size="32rpx" color="#DADADA" />
          <text class="stat-text">{{template.viewCount || 0}}</text>
        </view>
      </view>
      <view class="template-tags" wx:if="{{template.tags && template.tags.length > 0}}">
        <view class="tag-item" wx:for="{{template.tags}}" wx:key="*this">#{{item}}</view>
      </view>
    </view>

    <!-- 收藏按钮 - 固定悬浮 -->
    <view class="favorite-fab" bindtap="onToggleFavorite">
      <t-icon name="{{isFavorite ? 'star-filled' : 'star'}}" size="48rpx" color="{{isFavorite ? '#FFD700' : '#999'}}" />
    </view>

    <!-- 点赞按钮 - 固定悬浮 -->
    <view class="like-fab" bindtap="onToggleLike">
      <t-icon name="{{isLiked ? 'heart-filled' : 'heart'}}" size="48rpx" color="{{isLiked ? '#FF4444' : '#999'}}" />
    </view>

    <!-- 删除按钮 - 固定悬浮（仅创建者可见） -->
    <view class="delete-fab" wx:if="{{isCreator}}" bindtap="onDeleteTemplate">
      <t-icon name="delete" size="48rpx" color="#FF4444" />
    </view>

    <!-- 上传按钮 - 固定悬浮 -->
    <view class="upload-fab" bindtap="onUpload">
      <t-icon name="add" size="48rpx" color="#fff" />
    </view>

    <!-- 排序栏 -->
    <view class="sort-bar">
      <view class="sort-left">
        <text class="sort-title">照片 ({{photos.length}})</text>
      </view>
      <view class="sort-right">
        <text class="sort-label" data-type="hot" bindtap="onSortChange" style="{{sortType === 'hot' ? 'color: #FFA53D;' : 'color: #333;'}}">热度</text>
        <t-icon name="caret-down-small" size="32rpx" color="{{sortType === 'hot' ? '#FFA53D' : '#333'}}" />
        <text class="sort-label" data-type="time" bindtap="onSortChange" style="{{sortType === 'time' ? 'color: #FFA53D;' : 'color: #333;'}}">发布时间</text>
        <t-icon name="caret-down-small" size="32rpx" color="{{sortType === 'time' ? '#FFA53D' : '#333'}}" />
      </view>
    </view>

    <!-- 照片列表 - 双排瀑布流 -->
    <view class="photo-list waterfall-container">
      <!-- 左列 -->
      <view class="waterfall-column">
        <view class="photo-card" wx:for="{{leftColumnPhotos}}" wx:key="_id">
          <image
            class="photo-image"
            src="{{item.thumbnailUrl || item.photoUrl}}"
            mode="widthFix"
            lazy-load="{{true}}"
            webp="{{true}}"
            show-menu-by-longpress="{{true}}"
            data-index="{{item.originalIndex}}"
            bindtap="onPhotoTap"
            bindlongpress="onPhotoLongPress"
            data-photo-id="{{item._id}}"
            data-photo-name="{{item.userName}}的照片"
          />
          <view class="photo-info">
            <view class="author-info">
              <image class="author-avatar" src="{{item.userAvatar || defaultAvatar}}" mode="aspectFill" />
              <text class="author-name">{{item.userName}}</text>
            </view>
            <view class="photo-stats">
              <view class="stat-item">
                <t-icon name="browse" size="20rpx" color="#d3d3d3" />
                <text class="stat-num">{{item.viewCount || 0}}</text>
              </view>
              <view class="stat-item" data-photo-id="{{item._id}}" catchtap="onPhotoFavorite">
                <t-icon name="star-filled" size="20rpx" color="{{item.isFavorited ? '#FFD700' : '#DADADA'}}" />
                <text class="stat-num">{{item.favoriteCount || 0}}</text>
              </view>
              <view class="stat-item" data-photo-id="{{item._id}}" catchtap="onPhotoLike">
                <t-icon name="heart-filled" size="20rpx" color="{{item.isLiked ? '#FF4444' : '#DADADA'}}" />
                <text class="stat-num">{{item.likeCount || 0}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 右列 -->
      <view class="waterfall-column">
        <view class="photo-card" wx:for="{{rightColumnPhotos}}" wx:key="_id">
          <image
            class="photo-image"
            src="{{item.thumbnailUrl || item.photoUrl}}"
            mode="widthFix"
            lazy-load="{{true}}"
            webp="{{true}}"
            show-menu-by-longpress="{{true}}"
            data-index="{{item.originalIndex}}"
            bindtap="onPhotoTap"
            bindlongpress="onPhotoLongPress"
            data-photo-id="{{item._id}}"
            data-photo-name="{{item.userName}}的照片"
          />
          <view class="photo-info">
            <view class="author-info">
              <image class="author-avatar" src="{{item.userAvatar || defaultAvatar}}" mode="aspectFill" />
              <text class="author-name">{{item.userName}}</text>
            </view>
            <view class="photo-stats">
              <view class="stat-item">
                <t-icon name="browse" size="20rpx" color="#d3d3d3" />
                <text class="stat-num">{{item.viewCount || 0}}</text>
              </view>
              <view class="stat-item" data-photo-id="{{item._id}}" catchtap="onPhotoFavorite">
                <t-icon name="star-filled" size="20rpx" color="{{item.isFavorited ? '#FFD700' : '#DADADA'}}" />
                <text class="stat-num">{{item.favoriteCount || 0}}</text>
              </view>
              <view class="stat-item" data-photo-id="{{item._id}}" catchtap="onPhotoLike">
                <t-icon name="heart-filled" size="20rpx" color="{{item.isLiked ? '#FF4444' : '#DADADA'}}" />
                <text class="stat-num">{{item.likeCount || 0}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{photos.length === 0 && !loading}}">
      <t-icon name="image" size="120rpx" color="#ddd" />
      <text class="empty-text">暂无照片</text>
    </view>
  </view>
</view>
