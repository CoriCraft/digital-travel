/* pages/template-detail/template-detail.wxss */
.container {
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: transparent;
  padding-top: var(--status-bar-height);
}

.nav-content {
  height: var(--nav-bar-height);
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.nav-left {
  display: flex;
  align-items: center;
  color: #1a1a1a;
}

.nav-title {
  margin-left: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* 页面内容 */
.page-content {
  padding-top: calc(var(--status-bar-height) + var(--nav-bar-height));
  overflow-x: hidden;
}

/* 模板信息卡片 */
.template-header {
  position: relative;
  width: 100vw;
  height: 500rpx;
  overflow: hidden;
  background-color: #f5f5f5;
}

.template-cover {
  width: 100vw;
  height: 100%;
  display: block;
}

.template-info-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 32rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.8), rgba(0,0,0,0));
  color: #fff;
}

.template-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.template-name {
  font-size: 44rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

.official-badge {
  padding: 4rpx 16rpx;
  background-color: #82F45F;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #fff;
}

.template-description {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 24rpx;
  display: block;
}

.template-stats {
  display: flex;
  align-items: center;
}

.stat-item {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
}

.stat-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 8rpx;
}

/* 上传按钮 */
.upload-btn {
  margin: 32rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-text {
  font-size: 32rpx;
  color: #fff;
  margin-left: 16rpx;
  font-weight: 600;
}

/* 收藏按钮 - 悬浮 */
.favorite-fab {
  position: fixed;
  right: 40rpx;
  bottom: 400rpx;
  width: 112rpx;
  height: 112rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 99;
}

/* 点赞按钮 - 悬浮 */
.like-fab {
  position: fixed;
  right: 40rpx;
  bottom: 260rpx;
  width: 112rpx;
  height: 112rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 99;
}

/* 删除按钮 - 悬浮（仅创建者可见） */
.delete-fab {
  position: fixed;
  right: 40rpx;
  bottom: 540rpx;
  width: 112rpx;
  height: 112rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 99;
}

/* 上传按钮 */
.upload-fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #82F45F 0%, #6FD84A 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(130, 244, 95, 0.4);
  z-index: 99;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background-color: #fff;
  margin: 0 0 16rpx;
  border-radius: 0;
}

.sort-left {
  display: flex;
  align-items: center;
}

.sort-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.sort-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sort-label {
  font-size: 28rpx;
  color: #666;
  margin-left: 16rpx;
  transition: color 0.3s ease;
}

/* 照片列表 - 瀑布流 */
.photo-list {
  padding: 0 0 32rpx;
}

.waterfall-container {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 16rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.photo-card {
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 16rpx;
}

.photo-image {
  width: 100%;
  display: block;
  background-color: #f5f5f5;
  min-height: 200rpx;
}

.photo-info {
  padding: 16rpx;
}

.author-info {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.author-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.author-name {
  font-size: 24rpx;
  color: #666;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photo-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.photo-stats .stat-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  transition: background-color 0.2s;
}

.photo-stats .stat-item:active {
  background-color: rgba(0, 0, 0, 0.05);
}

.stat-num {
  font-size: 22rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-top: 24rpx;
}

.empty-tip {
  font-size: 28rpx;
  color: #ccc;
  margin-top: 16rpx;
}