/* pages/template-detail/template-detail.wxss */
.container {
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: transparent;
  padding-top: var(--status-bar-height);
}

.nav-content {
  height: var(--nav-bar-height);
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.nav-left {
  display: flex;
  align-items: center;
  color: #1a1a1a;
}

.back-icon {
  width: 30px;
  height: 35px;
  background-image: url("data:image/svg+xml,%3Csvg width='30' height='35' viewBox='0 0 30 35' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12.5 11.6666L7.5 17.5M7.5 17.5L12.5 23.3333M7.5 17.5L22.5 17.5' stroke='%23000E08' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.nav-title {
  margin-left: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* 页面内容 */
.page-content {
  padding-top: calc(var(--status-bar-height) + var(--nav-bar-height));
  overflow-x: hidden;
}

/* 模板信息卡片 */
.template-header {
  position: relative;
  width: 100vw;
  height: 460rpx;
  overflow: hidden;
  background-color: #f5f5f5;
}

.template-cover {
  width: 100vw;
  height: 100%;
  display: block;
}

/* 模板信息区域 */
.template-info-box {
  margin: -24rpx -32rpx 0;
  padding: 32rpx 64rpx;
  background: #FFFFFF;
  box-shadow: 2rpx 4rpx 12rpx rgba(0, 0, 0, 0.1);
  border-radius: 26rpx;
  position: relative;
  z-index: 10;
}

.template-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.template-name {
  font-size: 34rpx;
  font-weight: 500;
  color: #3E3E3E;
  margin-right: 16rpx;
  line-height: 34rpx;
}

.official-badge {
  padding: 0 12rpx;
  height: 32rpx;
  line-height: 32rpx;
  background-color: #7FD73D;
  border-radius: 7rpx;
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.template-stats {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
}

.stat-text {
  font-size: 20rpx;
  color: #757575;
  margin-left: 8rpx;
  font-weight: 500;
}

.template-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.tag-item:nth-child(3n+1) {
  background: linear-gradient(270deg, #FFC543 0%, #FF8607 100%);
}

.tag-item:nth-child(3n+2) {
  background: linear-gradient(90deg, #FF890A 0%, #FFC341 100%);
}

.tag-item:nth-child(3n+3) {
  background: linear-gradient(270deg, #FFC03E 0%, #FF8F10 100%);
}

/* 上传按钮 */
.upload-btn {
  margin: 32rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-text {
  font-size: 32rpx;
  color: #fff;
  margin-left: 16rpx;
  font-weight: 600;
}

/* 收藏按钮 - 悬浮 */
.favorite-fab {
  position: fixed;
  right: 40rpx;
  bottom: 400rpx;
  width: 112rpx;
  height: 112rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 99;
}

/* 点赞按钮 - 悬浮 */
.like-fab {
  position: fixed;
  right: 40rpx;
  bottom: 260rpx;
  width: 112rpx;
  height: 112rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 99;
}

/* 删除按钮 - 悬浮（仅创建者可见） */
.delete-fab {
  position: fixed;
  right: 40rpx;
  bottom: 540rpx;
  width: 112rpx;
  height: 112rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 99;
}

/* 上传按钮 */
.upload-fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #82F45F 0%, #6FD84A 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(130, 244, 95, 0.4);
  z-index: 99;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background-color: transparent;
}

.sort-left {
  display: flex;
  align-items: center;
}

.sort-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.sort-right {
  display: flex;
  align-items: center;
}

.sort-label {
  font-size: 26rpx;
  color: #333;
  margin-left: 24rpx;
  margin-right: 4rpx;
  transition: color 0.3s ease;
}

/* 照片列表 - 瀑布流 */
.photo-list {
  padding: 0 0 32rpx;
}

.waterfall-container {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 16rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.photo-card {
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 16rpx;
}

.photo-image {
  width: 100%;
  display: block;
  background-color: #f5f5f5;
  min-height: 200rpx;
}

.photo-info {
  padding: 16rpx 16rpx 24rpx;
}

.author-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.author-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.author-name {
  font-size: 24rpx;
  color: #666;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photo-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.photo-stats .stat-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  transition: background-color 0.2s;
}

.photo-stats .stat-item:active {
  background-color: rgba(0, 0, 0, 0.05);
}

.stat-num {
  font-size: 20rpx;
  color: #b3b3b3;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-top: 24rpx;
}

.empty-tip {
  font-size: 28rpx;
  color: #ccc;
  margin-top: 16rpx;
}