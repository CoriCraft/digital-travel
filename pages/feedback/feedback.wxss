/* pages/feedback/feedback.wxss */

page {
  height: 100vh;
  background: #F5F5F5;
}

.container {
  height: 100%;
  width: 100%;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: transparent;
}

.nav-content {
  width: 100%;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.nav-left {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.nav-right-placeholder {
  width: 48rpx;
}

/* 主内容 */
.main-scroll {
  height: 100%;
  width: 100%;
}

/* 区块 */
.section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  padding: 24rpx 24rpx 16rpx;
}

.required {
  color: #FF4444;
}

/* 反馈类型 */
.type-list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 0 24rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.type-item.active {
  border-color: #3ECE79;
  background: rgba(62, 206, 121, 0.05);
}

.type-text {
  font-size: 24rpx;
  color: #666;
}

.type-item.active .type-text {
  color: #3ECE79;
  font-weight: 500;
}

/* 文本域 */
.textarea-wrapper {
  background: #FFFFFF;
  margin: 0 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  position: relative;
}

.feedback-textarea {
  width: 100%;
  min-height: 240rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 图片上传 */
.image-upload {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx;
  flex-wrap: wrap;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}

.upload-image {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  background: #FFFFFF;
  border: 2rpx dashed #DDDDDD;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: #999;
}

.image-tip {
  font-size: 24rpx;
  color: #999;
  padding: 12rpx 24rpx 0;
}

/* 输入框 */
.input-wrapper {
  background: #FFFFFF;
  margin: 0 24rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
}

.feedback-input {
  width: 100%;
  height: 88rpx;
  font-size: 28rpx;
  color: #333;
}

.contact-tip {
  font-size: 24rpx;
  color: #999;
  padding: 12rpx 24rpx 0;
}

/* 提交按钮 */
.submit-section {
  padding: 40rpx 24rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #3ECE79 0%, #2AB361 100%);
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(62, 206, 121, 0.3);
}

.submit-btn[disabled] {
  opacity: 0.6;
}

/* 历史反馈 */
.history-list {
  background: #FFFFFF;
  margin: 0 24rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
}

.history-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.history-item:last-child {
  border-bottom: none;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.history-type {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.history-type-text {
  font-size: 26rpx;
  color: #666;
}

.history-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status-pending {
  background: rgba(255, 152, 0, 0.1);
  color: #FF9800;
}

.status-processing {
  background: rgba(33, 150, 243, 0.1);
  color: #2196F3;
}

.status-resolved {
  background: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

.history-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.history-time {
  font-size: 24rpx;
  color: #999;
}
