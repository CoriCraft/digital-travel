/* pages/purchase/purchase.wxss */

.custom-nav {
  width: 100%;
  background-color: #ffffff;
}

/* 状态栏高度 */
.status-bar {
  height: var(--status-bar-height);
}

/* 导航栏主体 */
.nav-content {
  height: var(--nav-bar-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx;
  box-sizing: border-box;
  border-bottom: 1px solid #eee;
}

/* 左右两侧固定宽度 */
.nav-left,
.nav-right {
  width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 中间标题 */
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 轮播展示 */
.card-theme {
  --td-swiper-radius: 0;
  --td-swiper-item-padding: 0 12rpx;
  --td-swiper-nav-dot-color: var(--td-bg-color-component, #e7e7e7);
  --td-swiper-nav-dot-active-color: var(--td-brand-color, #0052d9);

  padding-bottom: 18px;
}

.card-theme .card-theme-nav {
  bottom: -18px;
}

.scale-candidate {
  height: 126px !important;
}

.scale-current {
  border-radius: 30rpx;
  overflow: hidden;
}

/* 横向搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #d4f4dd;
}

/* 图标容器（控制大小 + 居中） */
.search-icon {
  width: 56rpx;
  height: 56rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-right: 16rpx; /* 和输入框的距离 */
}

/* 控制 t-icon 尺寸 */
.search-icon t-icon {
  font-size: 36rpx; /* 核心：控制图标大小 */
}

/* 输入框占满剩余空间 */
.search-input {
  flex: 1;
}

/* 外层：画胶囊形状 */
.search-input-wrapper {
  height: 64rpx;
  display: flex;
  align-items: center;

  border: 5rpx solid #3b82f6;
  border-radius: 33rpx;
  background-color: #fff;

  padding: 0 16rpx;
  overflow: hidden;
}

/* 输入框本体 */
.search-input-inner {
  flex: 1;

  --td-input-vertical-padding: 0;
  --td-input-horizontal-padding: 0;

  font-size: 28rpx;
}

/* 右侧搜索按钮 */
.search-btn {
  width: 44rpx;
  height: 44rpx;
  padding: 0 24rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 22rpx;
  background-color: #22c55e;
  color: #fff;

  font-size: 22rpx;
  box-shadow: 4rpx 4rpx 8rpx rgba(0, 0, 0, 0.18);
}

.waterfall {
  display: flex;
  padding: 24rpx;
  box-sizing: border-box;
  gap: 12rpx;
}

.column {
  flex: 1;
}

.goods-card-shadow {
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
}

.goods-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.goods-card image {
  width: 100%;
}

.goods-info {
  padding: 16rpx;
}

.goods-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.goods-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.tag {
  padding: 2rpx 8rpx;
  font-size: 20rpx;
  border-radius: 8rpx;
  background-color: #fff2e8;
  color: #ff7a00;
}

.goods-sold {
  font-size: 22rpx;
  color: #999;
  text-align: right;
}
