/* pages/purchase/purchase.wxss */

/* --- 全局容器 --- */
.page-container {
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* --- 导航栏 --- */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background: transparent;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 100%;
}

.nav-left,
.nav-right-placeholder {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

/* --- 主滚动区 --- */
.main-scroll {
  position: relative;
  height: 100vh;
  box-sizing: border-box;
  z-index: 1;
}

/* --- 1. Banner --- */
.banner-section {
  padding: 20rpx 24rpx;
}

.banner-swiper {
  border-radius: 24rpx;
  overflow: hidden;
  /* 核心修改：高度加高到 420rpx，解决显示不全问题 */
  height: 420rpx !important;
  box-shadow: 0 8rpx 20rpx rgba(166, 219, 178, 0.4);
  transition: all 0.3s ease;
}

.banner-swiper:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(166, 219, 178, 0.6);
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

/* --- 2. 搜索栏 --- */
.search-section {
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.search-input-box {
  flex: 1;
  height: 80rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
}

.search-icon-inside {
  margin-right: 12rpx;
}

.real-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333;
}

.placeholder-style {
  color: #999;
}

.search-btn-block {
  width: 140rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #82F45F 0%, #6FD84A 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(130, 244, 95, 0.3);
}

/* --- 3. Tabs --- */
.tabs-section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.tabs-row {
  display: flex;
  align-items: center;
  position: relative;
}

.tabs-list {
  flex: 1;
  display: flex;
  justify-content: space-between; 
  padding-right: 30rpx; 
}

.tab-item {
  font-size: 30rpx;
  color: #666;
  position: relative;
  padding-bottom: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tab-item.active {
  font-size: 34rpx;
  font-weight: bold;
  color: #FF7A00;
}

.tab-item.active .tab-line {
  position: absolute;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  background: #FF7A00;
  border-radius: 4rpx;
}

.tab-arrow {
  width: 40rpx;
  display: flex;
  justify-content: flex-end;
}

/* --- 4. 瀑布流列表 --- */
.waterfall-container {
  padding: 0 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.goods-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.card-img-box {
  position: relative;
  width: 100%;
}

.goods-img {
  width: 100%;
  display: block;
}

.ai-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  backdrop-filter: blur(4px);
}

.goods-info {
  padding: 20rpx;
}

.goods-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.goods-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.tag-hot {
  background: #FF4D4F;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.tag-discount-text {
  color: #FF4D4F;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-green {
  border: 1rpx solid #82F45F;
  color: #82F45F;
  font-size: 20rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
}

.tag-plain {
  background: #F5F5F5;
  color: #999;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.goods-bottom {
  display: flex;
  justify-content: flex-end;
}

.goods-sold {
  font-size: 22rpx;
  color: #BBB;
}

/* --- 5. 悬浮按钮 --- */
.float-help {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 110rpx;
  height: 110rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
  z-index: 99;
}

.help-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
}

.float-help text {
  font-size: 20rpx;
  color: #82F45F;
}