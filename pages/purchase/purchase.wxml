<view class="page-container">
  <view class="top-bg-layer"></view>

  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="onHomeTap">
        <t-icon name="home" size="48rpx" color="#333" />
      </view>
      <view class="nav-title">产品购买</view>
      <view class="nav-right-placeholder"></view>
    </view>
  </view>

  <scroll-view type="list" scroll-y class="main-scroll" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    
    <view class="banner-section">
      <t-swiper
        current="{{current}}"
        autoplay="{{autoplay}}"
        duration="{{500}}"
        interval="{{5000}}"
        list="{{recommendList}}"
        navigation="{{ { type: 'dots' } }}"
        image-props="{{ { mode: 'aspectFill' } }}"
        t-class="banner-swiper"
        t-class-image="banner-image"
      />
    </view>

    <view class="search-section">
      <view class="search-input-box">
        <t-icon name="search" size="36rpx" color="#999" class="search-icon-inside" />
        <input class="real-input" placeholder="猜你喜欢..." placeholder-class="placeholder-style" confirm-type="search" bindconfirm="onSearch" />
      </view>
      <view class="search-btn-block" bindtap="onSearch">搜索</view>
    </view>

    <view class="tabs-section">
      <view class="tabs-row">
        <view class="tabs-list">
          <view class="tab-item active">
            <text class="tab-text">推荐</text>
            <view class="tab-line"></view>
          </view>
          <view class="tab-item">土特产</view>
          <view class="tab-item">文创产品</view>
        </view>
        
        <view class="tab-arrow">
          <t-icon name="chevron-down" size="40rpx" color="#666" />
        </view>
      </view>
    </view>

    <view class="waterfall-container">
      <view class="column">
        <block wx:for="{{leftList}}" wx:key="id">
          <view class="goods-card" bindtap="onGoodsTap" data-item="{{item}}">
            <view class="card-img-box">
              <image src="{{item.img}}" mode="widthFix" class="goods-img" />
              <view class="ai-badge" wx:if="{{index === 0}}">AI定制</view>
            </view>
            <view class="goods-info">
              <view class="goods-name">{{item.name}}</view>
              
              <view class="goods-tags" wx:if="{{item.tags.length > 0}}">
                <block wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">
                  <view wx:if="{{item.tagType === 'hot'}}" class="tag-hot">{{tag}}</view>
                  <view wx:elif="{{item.tagType === 'discount-text'}}" class="tag-discount-text">{{tag}}</view>
                  <view wx:elif="{{item.tagType === 'green'}}" class="tag-green">{{tag}}</view>
                  <view wx:else class="tag-plain">{{tag}}</view>
                </block>
              </view>

              <view class="goods-bottom">
                <text class="goods-sold">已售 {{item.sold}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>

      <view class="column">
        <block wx:for="{{rightList}}" wx:key="id">
          <view class="goods-card" bindtap="onGoodsTap" data-item="{{item}}">
            <view class="card-img-box">
              <image src="{{item.img}}" mode="widthFix" class="goods-img" />
            </view>
            <view class="goods-info">
              <view class="goods-name">{{item.name}}</view>
              
              <view class="goods-tags" wx:if="{{item.tags.length > 0}}">
                <block wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">
                  <view wx:if="{{item.tagType === 'hot'}}" class="tag-hot">{{tag}}</view>
                  <view wx:elif="{{item.tagType === 'discount-text'}}" class="tag-discount-text">{{tag}}</view>
                  <view wx:elif="{{item.tagType === 'green'}}" class="tag-green">{{tag}}</view>
                  <view wx:else class="tag-plain">{{tag}}</view>
                </block>
              </view>

              <view class="goods-bottom">
                <text class="goods-sold">已售 {{item.sold}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>
    
    <view style="height: 120rpx;"></view>
  </scroll-view>

  <view class="float-help">
    <image src="/static/icons/help.svg" class="help-icon"></image>
    <text>帮助</text>
  </view>
</view>