<view class="page-container">
  <view class="top-bg-layer"></view>

  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="onHomeTap">
        <t-icon name="home" size="48rpx" color="#333" />
      </view>
      <view class="nav-title">产品购买</view>
      <view class="nav-right-placeholder"></view>
    </view>
  </view>

  <scroll-view type="list" scroll-y class="main-scroll" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    
    <view class="banner-section">
      <t-swiper
        current="{{current}}"
        autoplay="{{autoplay}}"
        duration="{{500}}"
        interval="{{5000}}"
        list="{{recommendList}}"
        navigation="{{ { type: 'dots' } }}"
        image-props="{{ { mode: 'aspectFill' } }}"
        t-class="banner-swiper"
        t-class-image="banner-image"
        t-class-navigation="custom-navigation"
        t-class-nav-item="custom-nav-item"
        bindchange="onSwiperChange"
        bindclick="onBannerClick"
      />
    </view>

    <!-- 搜索框 -->
    <view class="search-bar-wrapper">
      <view class="custom-search-bar">
        <view class="search-icon">
          <t-icon name="search" size="36rpx" color="#999" />
        </view>
        <input class="search-input" placeholder="猜你喜欢..." placeholder-class="search-placeholder" value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="onSearch" />
        <view class="search-btn" bindtap="onSearch">搜索</view>
      </view>
    </view>

    <view class="tabs-section">
      <view class="tabs-row">
        <view class="tabs-list">
          <view class="tab-item {{currentCategory === '推荐' ? 'active' : ''}}" bindtap="onCategoryChange" data-category="推荐">
            <text class="tab-text">推荐</text>
            <view class="tab-line" wx:if="{{currentCategory === '推荐'}}"></view>
          </view>
          <view class="tab-item {{currentCategory === '土特产' ? 'active' : ''}}" bindtap="onCategoryChange" data-category="土特产">
            <text class="tab-text">土特产</text>
            <view class="tab-line" wx:if="{{currentCategory === '土特产'}}"></view>
          </view>
          <view class="tab-item {{currentCategory === '文创产品' ? 'active' : ''}}" bindtap="onCategoryChange" data-category="文创产品">
            <text class="tab-text">文创产品</text>
            <view class="tab-line" wx:if="{{currentCategory === '文创产品'}}"></view>
          </view>
        </view>

        <view class="tab-arrow">
          <t-icon name="chevron-down" size="40rpx" color="#666" />
        </view>
      </view>
    </view>

    <view class="waterfall-container">
      <view class="column">
        <block wx:for="{{leftList}}" wx:key="_id">
          <view class="goods-card" bindtap="onGoodsTap" data-item="{{item}}">
            <view class="card-img-box">
              <image src="{{item.img}}" mode="widthFix" class="goods-img" lazy-load="{{true}}" />
              <!-- 热门标签 -->
              <view class="hot-badge" wx:if="{{item.isHot}}">🔥 热门</view>
            </view>
            <view class="goods-info">
              <view class="goods-name">{{item.name}}</view>

              <view class="goods-tags" wx:if="{{item.tags.length > 0}}">
                <block wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">
                  <view wx:if="{{item.tagType === 'hot'}}" class="tag-hot">{{tag}}</view>
                  <view wx:elif="{{item.tagType === 'discount-text'}}" class="tag-discount-text">{{tag}}</view>
                  <view wx:elif="{{item.tagType === 'green'}}" class="tag-green">{{tag}}</view>
                  <view wx:else class="tag-plain">{{tag}}</view>
                </block>
              </view>
            </view>
          </view>
        </block>
      </view>

      <view class="column">
        <block wx:for="{{rightList}}" wx:key="_id">
          <view class="goods-card" bindtap="onGoodsTap" data-item="{{item}}">
            <view class="card-img-box">
              <image src="{{item.img}}" mode="widthFix" class="goods-img" lazy-load="{{true}}" />
              <!-- 热门标签 -->
              <view class="hot-badge" wx:if="{{item.isHot}}">🔥 热门</view>
            </view>
            <view class="goods-info">
              <view class="goods-name">{{item.name}}</view>

              <view class="goods-tags" wx:if="{{item.tags.length > 0}}">
                <block wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">
                  <view wx:if="{{item.tagType === 'hot'}}" class="tag-hot">{{tag}}</view>
                  <view wx:elif="{{item.tagType === 'discount-text'}}" class="tag-discount-text">{{tag}}</view>
                  <view wx:elif="{{item.tagType === 'green'}}" class="tag-green">{{tag}}</view>
                  <view wx:else class="tag-plain">{{tag}}</view>
                </block>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>
    
    <view style="height: 120rpx;"></view>
  </scroll-view>

  <view class="float-help" bindtap="onHelpTap">
    <image src="/static/icons/help.svg" class="help-icon"></image>
    <text>帮助</text>
  </view>
</view>