/* pages/album/detail.wxss */
.album-detail-page {
  width: 100%;
  min-height: 100vh;
  background: #f5f5f5;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: transparent;
  z-index: 1000;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
  padding: 0 32rpx;
}

.nav-left, .nav-right {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.nav-left image {
  width: 48rpx;
  height: 48rpx;
  padding: 12rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 50%;
  backdrop-filter: blur(10rpx);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

/* 内容滚动区域 */
.detail-scroll {
  height: 100vh;
  box-sizing: border-box;
}

/* 相册信息 */
.album-info {
  background: rgba(255,255,255,0.95);
  padding: 40rpx 32rpx;
  margin: 80rpx 32rpx 20rpx;
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
}

.album-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.album-meta {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.meta-item {
  color: #666;
}

.meta-divider {
  margin: 0 12rpx;
  color: #999;
}

/* 照片网格 */
.photo-grid {
  padding: 0 32rpx 32rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 100%;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: auto;
  display: block;
}

.photo-actions {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);
  opacity: 0;
  transition: opacity 0.3s;
}

.photo-item:active .photo-actions {
  opacity: 1;
}

.action-btn {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 空状态 */
.empty-state {
  padding: 200rpx 0;
  text-align: center;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #999;
}
