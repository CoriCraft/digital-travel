<view class="preview-container">
  <!-- 顶部工具栏 -->
  <view class="top-toolbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="toolbar-left" bindtap="onBack">
      <image src="/static/icons/arrow-left.svg" class="back-icon" />
    </view>
    <view class="toolbar-center">
      <text class="photo-counter">{{currentIndex + 1}} / {{photos.length}}</text>
    </view>
    <view class="toolbar-right"></view>
  </view>

  <!-- 占位，撑开 fixed 工具栏的高度 -->
  <view style="height: {{toolbarHeight}}px;"></view>

  <!-- 照片展示（三张：前一张 + 当前 + 后一张） -->
  <view
    class="photo-area"
    catchtouchstart="onTouchStart"
    catchtouchmove="onTouchMove"
    catchtouchend="onTouchEnd"
  >
    <view
      class="photo-slider {{animating ? 'slide-animate' : ''}}"
      style="transform: translateX({{offsetX}}px);"
    >
      <!-- 上一张 -->
      <view class="photo-slide">
        <image
          wx:if="{{currentIndex > 0}}"
          src="{{photos[currentIndex - 1].url}}"
          mode="widthFix"
          class="preview-image"
        />
      </view>
      <!-- 当前 -->
      <view class="photo-slide">
        <image
          src="{{photos[currentIndex].url}}"
          mode="widthFix"
          class="preview-image"
        />
      </view>
      <!-- 下一张 -->
      <view class="photo-slide">
        <image
          wx:if="{{currentIndex < photos.length - 1}}"
          src="{{photos[currentIndex + 1].url}}"
          mode="widthFix"
          class="preview-image"
        />
      </view>
    </view>
  </view>

  <!-- 操作区 -->
  <view class="action-bar">
    <view class="action-item" bindtap="onDownload">
      <image src="/static/icons/download.svg" class="action-icon action-icon-download" />
      <text class="action-text">下载</text>
    </view>

    <view class="action-item" bindtap="onShare">
      <image src="/static/icons/share.svg" class="action-icon" />
      <text class="action-text">分享</text>
    </view>

    <view class="action-item" bindtap="onDelete">
      <image src="/static/icons/delete.svg" class="action-icon" />
      <text class="action-text">删除</text>
    </view>
  </view>

  <!-- 缩略图 -->
  <scroll-view class="thumb-scroll" scroll-x="true" show-scrollbar="false">
    <view class="thumb-list">
      <view
        class="thumb-item {{currentIndex === index ? 'active' : ''}}"
        wx:for="{{photos}}"
        wx:key="index"
        data-index="{{index}}"
        bindtap="onClickThumb"
      >
        <image src="{{item.url}}" mode="aspectFill" class="thumb-image" />
      </view>
    </view>
  </scroll-view>
</view>
