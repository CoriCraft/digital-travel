/* pages/album/album.wxss */
.album-page {
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* 导航栏透明化，适配背景 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: transparent;
  z-index: 1000;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #333333;
}

.icon-img {
  width: 44rpx;
  height: 44rpx;
}

/* 列表容器 */
.album-list {
  padding: 20rpx 40rpx 150rpx; /* 底部预留 TabBar 空间 */
}

/* 卡片叠层样式实现 */
.album-card {
  position: relative;
  margin-bottom: 50rpx;
  padding-top: 15rpx; /* 为顶部叠层留位 */
}

.card-stack-bg {
  position: absolute;
  top: 0;
  left: 20rpx;
  right: 20rpx;
  height: 100rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 30rpx;
  z-index: 1;
}

.card-main {
  position: relative;
  background: #ffffff;
  border-radius: 30rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
  z-index: 2;
}

.card-image {
  width: 100%;
  height: 420rpx;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.card-footer {
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-meta {
  font-size: 26rpx;
  color: #666666;
}

.card-right {
  display: flex;
  align-items: center;
}

.photo-count {
  font-size: 26rpx;
  color: #999999;
  margin-right: 8rpx;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.4;
}

/* 浮动帮助按钮 */
.float-help {
  position: fixed;
  right: 40rpx;
  bottom: 220rpx;
  width: 110rpx;
  height: 110rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
  z-index: 99;
}

.help-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
}

.float-help text {
  font-size: 20rpx;
  color: #82F45F;
}