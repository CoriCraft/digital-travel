<view class="album-page">
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="goHome">
        <t-icon name="home" size="48rpx" color="#333" />
      </view>
      <view class="nav-title">旅拍相册</view>
      <view class="nav-right">
        <!-- 右侧图标已移除 -->
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="album-scroll" style="padding-top: {{statusBarHeight + navBarHeight}}px;">

    <!-- 旅拍机订单号查询 -->
    <view class="search-bar">
      <view class="search-input-wrapper">
        <view class="search-icon">
          <image src="/static/icons/search.svg" style="width:36rpx;height:36rpx;" />
        </view>
        <input
          class="search-input-inner"
          placeholder="输入旅拍机订单号查询照片"
          value="{{orderIdInput}}"
          bindinput="onOrderIdInput"
          confirm-type="search"
          bindconfirm="fetchOrderPhotos"
          placeholder-class="input-placeholder"
        />
        <view class="search-btn {{orderLoading ? 'search-btn-loading' : ''}}" bindtap="fetchOrderPhotos">
          <text wx:if="{{!orderLoading}}">查询</text>
          <text wx:else>···</text>
        </view>
      </view>

      <!-- 错误提示 -->
      <view class="order-error" wx:if="{{orderError}}">
        <text>{{orderError}}</text>
      </view>
    </view>

    <view class="album-list" wx:if="{{albumList.length > 0}}">
      <view class="album-card" wx:for="{{albumList}}" wx:key="id" bindtap="viewAlbum" data-id="{{item.id}}">
        <view class="card-stack-bg"></view>
        <view class="card-main">
          <view class="card-image">
            <image src="{{item.coverImage}}" mode="aspectFill" class="cover-img"></image>
          </view>
          <view class="card-footer">
            <view class="card-info">
              <text class="card-title">{{item.title}}</text>
              <view class="card-meta-row">
                <text class="card-meta">{{item.date}}</text>
                <text class="card-location" wx:if="{{item.locationName}}">· {{item.locationName}}</text>
              </view>
            </view>
            <view class="card-right">
              <text class="photo-count">{{item.photoCount}}张</text>
              <image src="/static/icons/arrow-right.svg" class="arrow-icon"></image>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="empty-state" wx:else>
      <text class="empty-text">暂无相册</text>
      <text class="empty-hint">扫描旅拍机二维码保存相册</text>
    </view>
  </scroll-view>

  <!-- 旅拍照片弹窗 -->
  <view class="album-dialog-mask" wx:if="{{albumDialogVisible}}" bindtap="onAlbumDialogClose">
    <view class="album-dialog-content" catchtap="">
      <view class="album-dialog-photo-single" wx:if="{{!albumLoading && albumPhotos.length > 0}}">
        <image
          src="{{albumPhotos[0]}}"
          class="album-dialog-photo-main"
          mode="widthFix"
          bindtap="previewOrderPhoto"
          data-index="0"
        />
      </view>
      <view class="album-dialog-loading" wx:if="{{albumLoading}}">保存中...</view>
      <text class="album-dialog-tip" wx:if="{{!albumLoading}}">共 {{albumPhotos.length}} 张照片，点击图片查看全部</text>
      <view class="album-dialog-btn-save" wx:if="{{!albumLoading}}" bindtap="onSaveAlbum">
        <text class="btn-save-text">保存到我的相册</text>
      </view>
    </view>
  </view>

  <!-- 保存成功提示 -->
  <view class="success-overlay" wx:if="{{showSaveSuccess}}">
    <view class="success-icon"></view>
    <text class="success-text">照片已保存至您的电子相册！</text>
  </view>

  <view class="float-help" bindtap="onHelpTap">
    <image src="/static/icons/help.svg" class="help-icon"></image>
    <text>帮助</text>
  </view>
</view>