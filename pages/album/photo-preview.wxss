/* pages/album/photo-preview.wxss */
.preview-container {
  width: 100%;
  height: 100vh;
  background: #000;
  position: relative;
}

/* 照片轮播 */
.photo-swiper {
  width: 100%;
  height: 100%;
}

.preview-image {
  width: 100%;
  height: 100%;
}

/* 顶部工具栏 */
.top-toolbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: linear-gradient(to bottom, rgba(0,0,0,0.5), transparent);
  z-index: 100;
}

.toolbar-left,
.toolbar-right {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.back-icon-white {
  width: 30px;
  height: 35px;
  filter: brightness(0) invert(1);
}

.toolbar-center {
  flex: 1;
  display: flex;
  justify-content: center;
}

.photo-counter {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
}

/* 底部工具栏 */
.bottom-toolbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
}

.toolbar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 32rpx;
}

.toolbar-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
  filter: brightness(0) invert(1);
}

.toolbar-text {
  font-size: 24rpx;
  color: #fff;
}
