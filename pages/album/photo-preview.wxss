/* pages/album/photo-preview.wxss */
.preview-container {
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 照片展示区 */
.photo-area {
  width: 100%;
  overflow: hidden;
}

.photo-slider {
  display: flex;
  width: 300%;
  margin-left: -100%;
}

.photo-slider.slide-animate {
  transition: transform 0.3s ease-out;
}

.photo-slide {
  width: 33.333%;
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.preview-image {
  width: 100%;
  display: block;
}

/* 顶部工具栏 */
.top-toolbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 100;
}

.toolbar-left,
.toolbar-right {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 30px;
  height: 35px;
}

.toolbar-center {
  flex: 1;
  display: flex;
  justify-content: center;
}

.photo-counter {
  font-size: 32rpx;
  color: #222;
  font-weight: 500;
}

/* 操作区 */
.action-bar {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 40rpx;
}

.action-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 10rpx;
  display: block;
}

.action-icon-download {
  width: 36rpx;
  height: 38rpx;
}

.action-text {
  font-size: 32rpx;
  color: #292929;
  line-height: 1;
}

/* 缩略图 */
.thumb-scroll {
  margin-top: 48rpx;
  width: 100%;
  white-space: nowrap;
}

.thumb-list {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
  box-sizing: border-box;
}

.thumb-item {
  width: 76rpx;
  height: 108rpx;
  margin-right: 24rpx;
  opacity: 0.55;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  overflow: hidden;
  flex-shrink: 0;
}

.thumb-item.active {
  opacity: 1;
  border-color: #222;
}

.thumb-image {
  width: 100%;
  height: 100%;
  display: block;
}
