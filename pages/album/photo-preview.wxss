/* pages/album/photo-preview.wxss */
.preview-container {
  width: 100%;
  min-height: 100vh;
  position: relative;
  box-sizing: border-box;
}

/* 照片轮播 */
.photo-swiper {
  width: 100%;
  height: auto;
}

.preview-image {
  width: 100%;
  height: auto;
  display: block;
}

/* 顶部工具栏 */
.top-toolbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 100;
}

.toolbar-left,
.toolbar-right {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.back-icon-white {
  width: 30px;
  height: 35px;
  filter: brightness(0) invert(1);
}

.toolbar-center {
  flex: 1;
  display: flex;
  justify-content: center;
}

.photo-counter {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
}

/* 操作区 */
.action-bar {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 40rpx;
}

.action-item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 10rpx;
}

.action-text {
  font-size: 34rpx;
  color: #222;
  line-height: 1;
}

/* 缩略图 */
.thumb-scroll {
  margin-top: 48rpx;
  width: 100%;
  white-space: nowrap;
}

.thumb-list {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
  box-sizing: border-box;
}

.thumb-item {
  width: 76rpx;
  height: 108rpx;
  margin-right: 24rpx;
  opacity: 0.55;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  overflow: hidden;
}

.thumb-item.active {
  opacity: 1;
  border-color: #222;
}

.thumb-image {
  width: 100%;
  height: 100%;
  display: block;
}
