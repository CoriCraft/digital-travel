<view class="container">
  <!-- 透明导航栏 -->
  <view class="nav-bar transparent" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="onBack">
        <view class="back-icon"></view>
      </view>
      <text class="nav-title">我的作品</text>
      <view class="nav-right-placeholder"></view>
    </view>
  </view>

  <!-- 主内容 -->
  <scroll-view scroll-y class="main-scroll" style="padding-top: {{statusBarHeight + navBarHeight}}px;" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">

    <!-- 我的照片 -->
    <view class="content-section">
      <view wx:if="{{photos.length === 0}}" class="empty">
        <t-icon name="image" size="160rpx" color="#CCCCCC" />
        <text class="empty-text">还没有上传照片</text>
        <text class="empty-tip">快去上传你的精彩照片吧</text>
      </view>

      <view wx:else class="waterfall-container">
        <!-- 左列 -->
        <view class="waterfall-column">
          <view class="photo-card" wx:for="{{leftColumnPhotos}}" wx:key="_id">
            <image
              class="photo-image"
              src="{{item.thumbnailUrl || item.photoUrl}}"
              mode="widthFix"
              lazy-load="{{true}}"
              data-index="{{item.originalIndex}}"
              bindtap="onPhotoTap"
            />
            <view class="photo-info">
              <view class="author-info">
                <image class="author-avatar" src="{{userAvatar || defaultAvatar}}" mode="aspectFill" />
                <text class="author-name">{{userName || '我'}}</text>
              </view>
              <view class="photo-stats">
                <view class="stat-item">
                  <t-icon name="browse" size="32rpx" color="#d3d3d3" />
                  <text class="stat-num">{{item.viewCount || 0}}</text>
                </view>
                <view class="stat-item" data-photo-id="{{item._id}}" catchtap="onPhotoFavorite">
                  <t-icon name="star-filled" size="32rpx" color="{{item.isFavorited ? '#FFD700' : '#DADADA'}}" />
                  <text class="stat-num">{{item.favoriteCount || 0}}</text>
                </view>
                <view class="stat-item" data-photo-id="{{item._id}}" catchtap="onPhotoLike">
                  <t-icon name="heart-filled" size="32rpx" color="{{item.isLiked ? '#FF4444' : '#DADADA'}}" />
                  <text class="stat-num">{{item.likeCount || 0}}</text>
                </view>
              </view>
            </view>
            <view class="photo-actions" catchtap="onDeletePhoto" data-id="{{item._id}}" data-index="{{item.originalIndex}}">
              <view class="action-btn delete">
                <t-icon name="delete" size="32rpx" color="#FF4444" />
              </view>
            </view>
          </view>
        </view>

        <!-- 右列 -->
        <view class="waterfall-column">
          <view class="photo-card" wx:for="{{rightColumnPhotos}}" wx:key="_id">
            <image
              class="photo-image"
              src="{{item.thumbnailUrl || item.photoUrl}}"
              mode="widthFix"
              lazy-load="{{true}}"
              data-index="{{item.originalIndex}}"
              bindtap="onPhotoTap"
            />
            <view class="photo-info">
              <view class="author-info">
                <image class="author-avatar" src="{{userAvatar || defaultAvatar}}" mode="aspectFill" />
                <text class="author-name">{{userName || '我'}}</text>
              </view>
              <view class="photo-stats">
                <view class="stat-item">
                  <t-icon name="browse" size="32rpx" color="#d3d3d3" />
                  <text class="stat-num">{{item.viewCount || 0}}</text>
                </view>
                <view class="stat-item" data-photo-id="{{item._id}}" catchtap="onPhotoFavorite">
                  <t-icon name="star-filled" size="32rpx" color="{{item.isFavorited ? '#FFD700' : '#DADADA'}}" />
                  <text class="stat-num">{{item.favoriteCount || 0}}</text>
                </view>
                <view class="stat-item" data-photo-id="{{item._id}}" catchtap="onPhotoLike">
                  <t-icon name="heart-filled" size="32rpx" color="{{item.isLiked ? '#FF4444' : '#DADADA'}}" />
                  <text class="stat-num">{{item.likeCount || 0}}</text>
                </view>
              </view>
            </view>
            <view class="photo-actions" catchtap="onDeletePhoto" data-id="{{item._id}}" data-index="{{item.originalIndex}}">
              <view class="action-btn delete">
                <t-icon name="delete" size="32rpx" color="#FF4444" />
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

  </scroll-view>
</view>
