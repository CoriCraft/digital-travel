<!-- pages/upload-photoset/upload-photoset.wxml -->
<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="--status-bar-height: {{statusBarHeight}}px; --nav-bar-height: {{navBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="onBack">
        <t-icon name="close" size="48rpx" />
      </view>
      <text class="nav-title">上传照片</text>
      <view class="nav-right"></view>
    </view>
  </view>

  <!-- 页面内容 -->
  <view class="page-content">
    <!-- 模板信息提示 -->
    <view class="template-info" wx:if="{{template}}">
      <view class="info-icon">
        <t-icon name="info-circle" size="32rpx" color="#667eea" />
      </view>
      <text class="info-text">上传到: {{template.name}}</text>
    </view>

    <!-- 表单区域 -->
    <view class="form-section">
      <!-- 照片选择 -->
      <view class="form-item">
        <view class="form-label">
          <text class="label-text">选择照片</text>
          <text class="required">*</text>
        </view>

        <!-- 照片预览或上传按钮 -->
        <view class="photo-container">
          <view class="photo-preview-wrapper" wx:if="{{photoUrl}}">
            <image class="photo-preview-large" src="{{photoUrl}}" mode="aspectFill" />
            <view class="photo-delete-btn" bindtap="onDeletePhoto">
              <t-icon name="close" size="40rpx" color="#fff" />
            </view>
          </view>

          <view class="photo-upload-area" wx:else bindtap="onChoosePhoto">
            <t-icon name="add" size="96rpx" color="#ccc" />
            <text class="upload-text">点击上传照片</text>
          </view>
        </view>
      </view>

      <!-- 提示信息 -->
      <view class="upload-tips">
        <view class="tip-item">
          <t-icon name="check-circle" size="28rpx" color="#52c41a" />
          <text class="tip-text">照片将进入审核,审核通过后展示</text>
        </view>
        <view class="tip-item">
          <t-icon name="check-circle" size="28rpx" color="#52c41a" />
          <text class="tip-text">请上传清晰、美观的照片</text>
        </view>
        <view class="tip-item">
          <t-icon name="check-circle" size="28rpx" color="#52c41a" />
          <text class="tip-text">请勿上传违规、侵权内容</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部提交按钮 -->
  <view class="submit-bar">
    <button class="submit-btn" bindtap="onSubmit" disabled="{{uploading}}">
      {{uploading ? '上传中...' : '提交审核'}}
    </button>
  </view>
</view>
