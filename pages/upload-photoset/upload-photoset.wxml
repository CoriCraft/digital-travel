<view class="container">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content" style="height: {{navBarHeight}}px;">
      <view class="nav-left" bindtap="onBack">
        <t-icon name="chevron-left" size="48rpx" color="#333" />
      </view>
      <text class="nav-title">上传照片</text>
      <view class="nav-right"></view>
    </view>
  </view>

  <view class="page-content" style="margin-top: {{statusBarHeight + navBarHeight}}px;">
    <view class="template-info" wx:if="{{template}}">
      <t-icon name="info-circle-filled" size="32rpx" color="#fa8c16" />
      <text class="info-text">上传至：{{template.name}}</text>
    </view>

    <view class="photo-card" wx:if="{{!photoUrl}}">
      <view class="photo-header">
        <text class="photo-title">选择照片</text>
        <text class="photo-required">*</text>
      </view>

      <view class="upload-trigger" bindtap="onChoosePhoto">
        <view class="camera-icon-group">
          <view class="icon-camera-body"></view>
          <view class="icon-camera-lens"></view>
          <view class="icon-plus-v"></view>
          <view class="icon-plus-h"></view>
        </view>
        <text class="upload-label">点击上传图片</text>
      </view>

      <view class="tips-box">
        <view class="tip-row">
          <view class="check-icon"></view>
          <text class="tip-content">照片将进入审核，审核通过后展示</text>
        </view>
        <view class="tip-row">
          <view class="check-icon"></view>
          <text class="tip-content">请上传清晰、美观的照片</text>
        </view>
        <view class="tip-row">
          <view class="check-icon"></view>
          <text class="tip-content">请勿上传违规、侵权内容</text>
        </view>
      </view>
    </view>

    <view class="photo-card" wx:else>
      <view class="photo-header">
        <text class="photo-title">选择照片</text>
        <text class="photo-required">*</text>
      </view>

      <view class="photo-preview-wrapper">
        <image class="photo-preview-large" src="{{photoUrl}}" mode="aspectFill" />
        <view class="photo-delete-btn" bindtap="onDeletePhoto">
          <t-icon name="close" size="32rpx" color="#fff" />
        </view>
      </view>

      <view class="tips-box">
        <view class="tip-row">
          <view class="check-icon"></view>
          <text class="tip-content">照片将进入审核，审核通过后展示</text>
        </view>
        <view class="tip-row">
          <view class="check-icon"></view>
          <text class="tip-content">请上传清晰、美观的照片</text>
        </view>
        <view class="tip-row">
          <view class="check-icon"></view>
          <text class="tip-content">请勿上传违规、侵权内容</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer-safe-area">
    <button class="action-submit-btn" bindtap="onSubmit" disabled="{{uploading}}">
      <text class="btn-text">{{uploading ? '提交中...' : '立即提交'}}</text>
    </button>
  </view>
</view>
