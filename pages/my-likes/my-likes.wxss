/* pages/my-likes/my-likes.wxss */

page {
  height: 100vh;
  background: #F5F5F5;
}

.container {
  height: 100%;
  width: 100%;
  padding: 0; /* 覆盖全局的 padding: 200rpx 0 */
  display: block; /* 覆盖全局的 flex 布局 */
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.nav-bar.transparent {
  background: transparent;
  box-shadow: none;
}

.nav-content {
  width: 100%;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.nav-left {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 30px;
  height: 35px;
  background-image: url("data:image/svg+xml,%3Csvg width='30' height='35' viewBox='0 0 30 35' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12.5 11.6666L7.5 17.5M7.5 17.5L12.5 23.3333M7.5 17.5L22.5 17.5' stroke='%23000E08' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.nav-right-placeholder {
  width: 48rpx;
}

/* 主内容 */
.main-scroll {
  height: 100%;
  width: 100%;
  box-sizing: border-box;
}

/* 标签切换 */
.tabs-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 49rpx; /* 修复对齐：抵消 content-section(24rpx) + template-grid(25rpx) 的叠加内边距 */
  gap: 36rpx; /* 调整两个按钮之间的间距 */
  margin: 32rpx 0;
}

.tab-item {
  flex: 1; /* 自动撑开，保证边缘绝对对齐 */
  display: flex;
  align-items: center;
  justify-content: center;
  height: 78rpx;
  font-family: 'Source Han Sans CN', sans-serif;
  font-style: normal;
  font-weight: 500;
  font-size: 28rpx;
  line-height: 40rpx;
  letter-spacing: 2rpx;
  border-radius: 40rpx;
  transition: all 0.3s;
  box-sizing: border-box;
}

.tab-item.active {
  background: linear-gradient(270deg, #B4E742 0%, #8DDC3E 100%);
  box-shadow: 4rpx 4rpx 8rpx rgba(0, 0, 0, 0.08);
  color: #3E3E3E;
  border: none;
}

.tab-item.inactive {
  border: 2rpx solid #7C7C7C;
  color: #7C7C7C;
  background: transparent;
}

/* 内容区域 */
.content-section {
  padding: 0 24rpx 40rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-top: 30rpx;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #CCCCCC;
}

/* 模板网格 */
.template-grid {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 0 25rpx;
}

.template-card {
  margin-bottom: 0;
  filter: drop-shadow(2px 2px 6px rgba(0, 0, 0, 0.1));
}

.template-cover-wrapper {
  width: 100%;
  background: #eee;
  border-radius: 26rpx 26rpx 0 0;
  overflow: hidden;
  display: block;
  position: relative;
}

.template-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10rpx);
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  z-index: 10;
}

.template-cover {
  width: 100%;
}

.template-info-box {
  position: relative;
  width: 100%;
  height: 190rpx;
  background: #FDFEF6;
  border-radius: 0 0 34rpx 34rpx;
  padding: 30rpx 40rpx;
  box-sizing: border-box;
}

.template-title {
  font-family: 'Source Han Sans CN', sans-serif;
  font-weight: 500;
  font-size: 32rpx;
  color: #3E3E3E;
  display: block;
  margin-bottom: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.like-star {
  position: absolute;
  right: 40rpx;
  top: 30rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.like-count {
  font-family: 'Source Han Sans CN', sans-serif;
  font-size: 26rpx;
  color: #4D4D4D;
}

.template-bottom-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.author-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.author-avatar {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #ccc;
}

.author-name {
  font-family: 'Source Han Sans CN', sans-serif;
  font-size: 26rpx;
  color: #757575;
}

.stats-group {
  display: flex;
  gap: 30rpx;
}

.stats-group .stat-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-family: 'Source Han Sans CN', sans-serif;
  font-size: 26rpx;
  color: #4D4D4D;
}

/* 照片网格 */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.photo-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
  aspect-ratio: 1;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.5), transparent);
}

.photo-stats {
  display: flex;
  gap: 16rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stat-text {
  font-size: 22rpx;
  color: #FFFFFF;
}

.like-btn-small {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}
