<view class="container">
  <!-- 透明导航栏 -->
  <view class="nav-bar transparent" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="onBack">
        <view class="back-icon"></view>
      </view>
      <text class="nav-title">我的喜欢</text>
      <view class="nav-right-placeholder"></view>
    </view>
  </view>

  <!-- 主内容 -->
  <scroll-view scroll-y class="main-scroll" style="padding-top: {{statusBarHeight + navBarHeight}}px;" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">

    <!-- 标签切换 -->
    <view class="tabs-container">
      <view
        class="tab-item {{currentTab === 0 ? 'active' : 'inactive'}}"
        data-index="{{0}}"
        bindtap="onTabChange"
      >模板</view>
      <view
        class="tab-item {{currentTab === 1 ? 'active' : 'inactive'}}"
        data-index="{{1}}"
        bindtap="onTabChange"
      >照片</view>
    </view>

    <!-- 喜欢的模板 -->
    <view class="content-section" wx:if="{{currentTab === 0}}">
      <view wx:if="{{templates.length === 0}}" class="empty">
        <t-icon name="thumb-up" size="160rpx" color="#CCCCCC" />
        <text class="empty-text">还没有点赞模板</text>
        <text class="empty-tip">快去点赞你喜欢的模板吧</text>
      </view>

      <view wx:else class="template-grid">
        <view wx:for="{{templates}}" wx:key="_id" class="template-card" data-id="{{item._id}}" bindtap="onTemplateTap">
          <view class="template-cover-wrapper">
            <image class="template-cover" src="{{item.cover}}" mode="widthFix"></image>
          </view>

          <view class="template-info-box">
            <text class="template-title">{{item.name}}</text>

            <view class="like-star" catchtap="onUnlikeTemplate" data-id="{{item._id}}" data-index="{{index}}">
              <t-icon name="thumb-up-filled" size="36rpx" color="#FF6B35" />
              <text class="like-count">{{item.likeCount || 0}}</text>
            </view>

            <view class="template-bottom-row">
              <view class="author-group">
                <image class="author-avatar" src="{{item.creatorAvatar || defaultAvatar}}" mode="aspectFill"></image>
                <text class="author-name">{{item.creatorName || '未知'}}</text>
              </view>

              <view class="stats-group">
                <view class="stat-item">
                  <t-icon name="image" size="28rpx" color="#4D4D4D" />
                  <text class="stat-num">{{item.photoSetCount || 0}}</text>
                </view>
                <view class="stat-item">
                  <t-icon name="star-filled" size="28rpx" color="{{item.isFavorited ? '#FFD700' : '#DADADA'}}" />
                  <text class="stat-num">{{item.favoriteCount || 0}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 喜欢的照片 -->
    <view class="content-section" wx:if="{{currentTab === 1}}">
      <view wx:if="{{photos.length === 0}}" class="empty">
        <t-icon name="thumb-up" size="160rpx" color="#CCCCCC" />
        <text class="empty-text">还没有点赞照片</text>
        <text class="empty-tip">快去点赞你喜欢的照片吧</text>
      </view>

      <view wx:else class="photo-grid">
        <view
          wx:for="{{photos}}"
          wx:key="_id"
          class="photo-card"
          data-id="{{item._id}}"
          data-index="{{index}}"
          bindtap="onPhotoTap"
        >
          <image class="photo-img" src="{{item.photoUrl}}" mode="aspectFill"></image>
          <view class="photo-overlay">
            <view class="photo-stats">
              <view class="stat-item">
                <t-icon name="heart-filled" size="24rpx" color="#fff" />
                <text class="stat-text">{{item.likeCount || 0}}</text>
              </view>
            </view>
          </view>
          <view class="like-btn-small" catchtap="onUnlikePhoto" data-id="{{item._id}}" data-index="{{index}}">
            <t-icon name="thumb-up-filled" size="32rpx" color="#FF6B35" />
          </view>
        </view>
      </view>
    </view>

  </scroll-view>
</view>
