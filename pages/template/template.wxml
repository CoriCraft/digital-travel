<view class="custom-nav" style="--status-bar-height: {{statusBarHeight}}px; --nav-bar-height: {{navBarHeight}}px;">
  <view class="nav-content">
    <view class="nav-left" bindtap="onLocationTap">
      <image class="location-icon" src="/static/pages/template/location.svg" />
      <text class="location-text">{{location}} ></text>
    </view>
    <view class="nav-right">
      <!-- 右侧图标已移除 -->
    </view>
  </view>
</view>

<!-- 页面内容，需要顶下来 -->
<view class="page-content">
  <!-- 搜索框 -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <view class="search-icon">
        <t-icon name="search" size="36rpx" color="#999" />
      </view>
      <input class="search-input-inner" placeholder="方山风景区" value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="onSearch" placeholder-class="input-placeholder" />
      <view class="search-btn" bindtap="onSearch">搜索</view>
    </view>
  </view>

  <scroll-view class="template-filter-scroll" scroll-x enable-flex enhanced show-scrollbar="{{false}}">
    <view class="template-filter">
      <view class="filter-tag {{currentTemplateFilter === item.value ? 'active' : ''}}" wx:for="{{templateFilterList}}" wx:key="value" data-value="{{item.value}}" bindtap="onTabChange">
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <!-- 创作模板按钮 -->

<view class="create-template-wrapper" bindtap="onCreateTemplate" wx:if="{{featuredTemplate}}">
  <view class="create-template-bg">
    <view class="create-template-card">
      <image class="create-icon-decoration" src="/static/icons/sctp.png" mode="aspectFit" />
      <view class="create-template-img-box">
        <image class="create-template-img" src="{{featuredTemplate.coverThumbnail || featuredTemplate.cover}}" mode="aspectFill"></image>
      </view>
      <view class="create-template-info">
        <view class="create-info-top">
          <text class="create-title">创作模板</text>
          <text class="create-desc">欢迎上传自己的照片模板</text>
        </view>
        <view class="create-info-bottom">
          <view class="create-avatars">
            <image wx:for="{{featuredTemplate.uploaderAvatars}}" wx:key="index" class="avatar-circle" src="{{item}}" wx:if="{{index < 3}}"></image>
            <view class="avatar-circle avatar-more" wx:if="{{featuredTemplate.uploaderAvatars && featuredTemplate.uploaderAvatars.length > 3}}">+{{featuredTemplate.uploaderAvatars.length - 3}}</view>
            <text class="avatar-text">{{featuredTemplate.photoSetCount || 0}}人已上传</text>
          </view>
          <view class="create-btn">立即上传 >></view>
        </view>
      </view>
    </view>
  </view>
</view>
<view class="create-canvas-btn" bindtap="onCreateTemplate" wx:else>
  <view class="canvas-icon">
    <t-icon name="add" size="48rpx" />
  </view>
  <text class="canvas-text">创作模板</text>
</view>

  <!-- 模板列表标签 -->
  <view class="template-category">
    <view class="category-left">
      <text class="category-title">模板列表</text>
    </view>
    <view class="category-right">
      <text class="sort-label" data-type="hot" bindtap="onSortChange" style="{{sortType === 'hot' ? 'color: #ff6b35;' : ''}}">热度</text>
      <t-icon name="caret-down-small" size="32rpx" color="{{sortType === 'hot' ? '#ff6b35' : '#999'}}" />
      <text class="sort-label" data-type="time" bindtap="onSortChange" style="{{sortType === 'time' ? 'color: #ff6b35;' : ''}}">发布时间</text>
      <t-icon name="caret-down-small" size="32rpx" color="{{sortType === 'time' ? '#ff6b35' : '#999'}}" />
    </view>
  </view>

  <!-- 模板列表 - 双排瀑布流 -->
  <view class="template-list">
    <view class="waterfall-container">
      <view class="waterfall-column">
        <view class="template-card" wx:for="{{leftColumnTemplates}}" wx:key="_id" data-id="{{item._id}}" bindtap="onTemplateTap" bindlongpress="onTemplateReport" data-name="{{item.name}}">
          <view class="template-card-content">
            <view class="template-image-wrapper">
              <image class="template-image" src="{{item.coverThumbnail || item.cover}}" mode="widthFix" lazy-load="{{true}}" />
              <view class="hot-badge" wx:if="{{item.isHot}}">🔥 热门</view>
            </view>
            <view class="template-info">
              <view class="title-row">
                <text class="template-title">{{item.name}}</text>
                <view class="official-badge-inline" wx:if="{{item.isOfficial}}">官方</view>
              </view>
              <view class="template-meta">
                <view class="author-info">
                  <t-icon name="user" size="22rpx" color="#ff6b35" />
                  <text class="author-name">{{item.creatorName}}</text>
                </view>
                <view class="stats-info">
                  <t-icon name="image" size="22rpx" color="#999" />
                  <text class="stat-text">{{item.photoSetCount || 0}}</text>
                  <t-icon name="star-filled" size="22rpx" color="{{item.isFavorited ? '#FFD700' : '#DADADA'}}" />
                  <text class="stat-text">{{item.favoriteCount || 0}}</text>
                  <t-icon name="heart-filled" size="22rpx" color="{{item.isLiked ? '#FF4444' : '#DADADA'}}" />
                  <text class="stat-text">{{item.likeCount || 0}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="waterfall-column">
        <view class="template-card" wx:for="{{rightColumnTemplates}}" wx:key="_id" data-id="{{item._id}}" bindtap="onTemplateTap" bindlongpress="onTemplateReport" data-name="{{item.name}}">
          <view class="template-card-content">
            <view class="template-image-wrapper">
              <image class="template-image" src="{{item.coverThumbnail || item.cover}}" mode="widthFix" lazy-load="{{true}}" />
              <view class="hot-badge" wx:if="{{item.isHot}}">🔥 热门</view>
            </view>
            <view class="template-info">
              <view class="title-row">
                <text class="template-title">{{item.name}}</text>
                <view class="official-badge-inline" wx:if="{{item.isOfficial}}">官方</view>
              </view>
              <view class="template-meta">
                <view class="author-info">
                  <t-icon name="user" size="22rpx" color="#ff6b35" />
                  <text class="author-name">{{item.creatorName}}</text>
                </view>
                <view class="stats-info">
                  <t-icon name="image" size="22rpx" color="#999" />
                  <text class="stat-text">{{item.photoSetCount || 0}}</text>
                  <t-icon name="star-filled" size="22rpx" color="{{item.isFavorited ? '#FFD700' : '#DADADA'}}" />
                  <text class="stat-text">{{item.favoriteCount || 0}}</text>
                  <t-icon name="heart-filled" size="22rpx" color="{{item.isLiked ? '#FF4444' : '#DADADA'}}" />
                  <text class="stat-text">{{item.likeCount || 0}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态提示 -->
    <view class="template-tip" wx:if="{{templates.length === 0 && !loading}}">
      <t-icon name="info-circle" size="28rpx" color="#999" />
      <text class="tip-text">暂无模板，快来创建第一个吧</text>
    </view>

    <!-- 底部提示 -->
    <view class="template-tip" wx:if="{{templates.length > 0 && !hasMore}}">
      <t-icon name="info-circle" size="28rpx" color="#999" />
      <text class="tip-text">已经到底了</text>
    </view>

    <!-- 加载更多提示 -->
    <view class="template-tip" wx:if="{{templates.length > 0 && hasMore && loading}}">
      <text class="tip-text">加载中...</text>
    </view>

    <!-- 快来选择提示 -->
    <view class="template-tip" wx:if="{{templates.length > 0 && hasMore && !loading}}">
      <t-icon name="info-circle" size="28rpx" color="#999" />
      <text class="tip-text">快来选择你喜欢的模板吧</text>
    </view>
  </view>

</view>

<!-- 旅拍相册弹窗 -->
<view class="album-dialog-mask" wx:if="{{albumDialogVisible}}" bindtap="onAlbumDialogClose">
  <view class="album-dialog-content" catchtap="">
    <!-- 只显示第一张照片 -->
    <view class="album-dialog-photo-single" wx:if="{{!albumLoading && albumPhotos.length > 0}}">
      <image
        src="{{albumPhotos[0].url || albumPhotos[0]}}"
        class="album-dialog-photo-main"
        mode="aspectFit"
      />
    </view>
    <view class="album-dialog-loading" wx:if="{{albumLoading}}">保存中...</view>
    <text class="album-dialog-tip" wx:if="{{!albumLoading}}">点击下方保存图片至旅拍相册</text>
    <view class="album-dialog-btn-save" wx:if="{{!albumLoading}}" bindtap="onSaveAlbum">
      <text class="btn-save-text">保存图片</text>
    </view>
  </view>
</view>

<!-- 保存成功提示 -->
<view class="success-overlay" wx:if="{{showSaveSuccess}}">
  <view class="success-icon"></view>
  <text class="success-text">照片已保存至您的电子相册！</text>
</view>